{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pokemon-field-guide.local/schemas/worlds-v2.schema.json",
  "type": "object",
  "properties": {
    "formatVersion": {
      "type": "integer",
      "minimum": 2,
      "maximum": 2,
      "const": 2
    },
    "worlds": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "rendering": {
            "type": "object",
            "properties": {
              "overviewImage": {
                "type": "string",
                "minLength": 1
              },
              "width": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              },
              "height": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              },
              "layers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "image": {
                      "type": "string",
                      "minLength": 1
                    },
                    "x": {
                      "type": "integer"
                    },
                    "y": {
                      "type": "integer"
                    },
                    "width": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 2147483647
                    },
                    "height": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 2147483647
                    },
                    "order": {
                      "type": "integer"
                    },
                    "minScale": {
                      "type": "number",
                      "minimum": 5E-324,
                      "maximum": 3
                    }
                  },
                  "required": [
                    "id",
                    "image",
                    "x",
                    "y",
                    "width",
                    "height",
                    "order",
                    "minScale"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              }
            },
            "required": [
              "overviewImage",
              "width",
              "height",
              "layers"
            ],
            "additionalProperties": false
          },
          "areas": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "regions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "points": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "x": {
                              "type": "number"
                            },
                            "y": {
                              "type": "number"
                            }
                          },
                          "required": [
                            "x",
                            "y"
                          ],
                          "additionalProperties": false
                        },
                        "minItems": 3
                      }
                    },
                    "required": [
                      "points"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1
                },
                "anchors": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "tileX": {
                        "type": "integer"
                      },
                      "tileY": {
                        "type": "integer"
                      },
                      "x": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "tileX",
                      "tileY",
                      "x",
                      "y"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "id",
                "regions",
                "anchors"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "rendering",
          "areas"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "formatVersion",
    "worlds"
  ],
  "additionalProperties": false
}
