    async Task ChangePlayableGame(ChangeEventArgs e)
    {
        var parts=((string?)e.Value)?.Split('|',2);if(parts?.Length!=2)return;
        var definition=catalog!.Games.FirstOrDefault(choice=>choice.Id==parts[0]);if(definition is null||!definition.Versions.Any(version=>version.Id==parts[1]))return;
        if(game?.Id!=definition.Id){progress.GameId=definition.Id;await LoadGameAsync(definition);}
        progress.Version=parts[1];progress.SelectedVersions[definition.Id]=parts[1];progress.Accent=ActiveVersion.Accent;await Save();await ApplyAppearance();
    }
