@page "/"
@inject IJSRuntime JS
@inject GamePackageLoader PackageLoader
@inject GameRulesRegistry RulesRegistry

<PageTitle>@(game?.PageTitle ?? "Pokémon Field Guide")</PageTitle>

<header class="topbar">
    <div class="brand"><span class="brand-ball">●</span><div><strong>POKEMON FIELD GUIDE</strong><small>@(game is null ? "INTERACTIVE MAP ATLAS" : $"Pokémon {ActiveVersion.Name}")</small></div></div>
    <div class="top-actions">
        <button class="header-icon desktop-dex" aria-label="Open Pokédex" @onclick="OpenPokedex"><span aria-hidden="true">▦</span></button>
        <button class="header-menu-button" aria-label="Open menu" aria-expanded="@menuOpen" @onclick="()=>menuOpen=!menuOpen"><span aria-hidden="true">☰</span><span>Menu</span></button>
        @if(menuOpen)
        {
            <button class="menu-scrim" aria-label="Close menu" @onclick="()=>menuOpen=false"></button>
            <section class="header-menu" aria-label="Application menu">
                <button class="menu-row mobile-dex" @onclick="OpenPokedex"><span>▦</span> Pokédex</button>
                <label>GAME<select value="@(game is null?null:$"{game.Id}|{progress.Version}")" @onchange="ChangePlayableGame">@foreach(var package in catalog?.Games??[]){@foreach(var version in package.Versions){<option value="@($"{package.Id}|{version.Id}")">Pokémon @version.Name</option>}}</select></label>
                <button class="menu-row" @onclick="ToggleTheme"><span>@(progress.Theme=="Dark"?"☀":"◐")</span> @(progress.Theme=="Dark"?"Use light mode":"Use dark mode")</button>
                <button class="menu-row" @onclick="ToggleAnimations"><span>@(progress.AnimationsEnabled?"⏸":"▶")</span> @(progress.AnimationsEnabled?"Disable sprite animations":"Enable sprite animations")</button>
                <div class="menu-separator"></div>
                <button class="menu-row" @onclick="OpenExport"><span>⇩</span> Export save data</button>
                <button class="menu-row" @onclick="OpenImport"><span>⇧</span> Import save data</button>
                <div class="menu-separator"></div>
                <button class="menu-row danger-row" @onclick="OpenReset"><span>!</span> Reset progress</button>
            </section>
        }
    </div>
</header>

@if (data is null && loadError is null) { <main class="loading-card">Rendering the map…</main> }
else if (data is null)
{
    <main class="loading-card load-error" role="alert">
        <strong>The field guide could not be loaded.</strong>
        <span>@loadError</span>
        <button @onclick="RetryLoad">Try again</button>
    </main>
}
else
{
    <main class="atlas-shell">
        <aside class="atlas-sidebar">
            <div class="atlas-heading"><span class="eyebrow">WORLD MAP</span><h1>@game?.AtlasTitle</h1></div>
            <div class="search"><span>⌕</span><input aria-label="Search locations and their contents" placeholder="Search locations, Pokémon, items…" value="@query" @oninput="SearchChanged" @onfocus="()=>searchOpen=true" /></div>
            @if(game?.Regions.Count > 1){<div class="map-filters">@foreach(var choice in game.Regions){<button class="@(currentRegion?.Id==choice.Id?"active":"")" @onclick="()=>ShowRegion(choice)">@choice.Name</button>}</div>}
            <nav class="outdoor-list @(!searchOpen?"closed":"")">
                @foreach (var area in OutdoorAreas)
                {
                    <button class="outdoor-row @(area==mapArea?"active":"")" @onclick="()=>SelectSearchArea(area)"><span><strong>@area.Name</strong><small>@area.Items.Count items · @(IsOutdoor(area.Id)?$"{RelevantEntrancesFor(area).Count()} entrances":"interior map")</small></span><b>@AreaPercent(area)%</b></button>
                }
            </nav>
            <div class="legend"><span><i class="legend-pin item-pin">◆</i> Item</span><span><i class="legend-pin hidden-pin">?</i> Hidden</span><span><i class="legend-pin door-pin">⌂</i> Entrance</span></div>
        </aside>

        <section class="map-stage">
            <div class="map-toolbar @(detailArea is not null?"panel-open":"")">
                <div><span class="eyebrow">CONNECTED WORLD / EXPLORE</span><h2>@currentRegion?.Name</h2></div>
                <div class="zoom-controls"><button aria-label="Zoom out" @onclick="()=>Zoom(.8)">−</button><button aria-label="Fit world map" @onclick="ResetView">⌖</button><button aria-label="Zoom in" @onclick="()=>Zoom(1.25)">+</button></div>
            </div>
            @if (currentWorld is not null)
            {
                <div class="map-viewport" @ref="mapViewport">
                    <div class="map-world" style="width:@(currentWorld.Width)px;height:@(currentWorld.Height)px">
                        <img src="@currentWorld.Image" alt="@(currentWorld.Id) connected game world" draggable="false" />
                        @foreach (var placement in currentWorld.Maps)
                        {
                            var area = AreaFor(placement.Id);
                            if (area is not null)
                            {
                                <button class="area-hotspot @(area==mapArea?"selected":"")" aria-label="@area.Name" style="left:@(placement.X)px;top:@(placement.Y)px;width:@(placement.Width)px;height:@(placement.Height)px" @onclick="()=>SelectArea(area)"></button>
                                @foreach (var item in area.Items.Where(item => item.X >= 0 && item.Y >= 0))
                                {
                                    <button aria-label="@item.Name — @item.Kind item" style="left:@(placement.X+item.X*16+8)px;top:@(placement.Y+item.Y*16+8)px" class="map-marker @(item.Kind=="Hidden"?"hidden-marker":"item-marker") @(CurrentProgress.Collected.Contains(item.Id)?"done":"")" @onclick="()=>InspectItem(area,item)"><span>@(item.Kind=="Hidden"?"?":"◆")</span><label>@area.Name · @item.Name</label></button>
                                }
                                @foreach (var entrance in RelevantEntrancesFor(area))
                                {
                                    <button aria-label="Enter @entrance.Name" style="left:@(placement.X+entrance.X*16+8)px;top:@(placement.Y+entrance.Y*16+8)px" class="map-marker entrance-marker" @onclick="()=>OpenEntrance(entrance.TargetId)"><span>⌂</span><label>@area.Name · @entrance.Name</label></button>
                                }
                            }
                        }
                    </div>
                </div>
            }
            <div class="map-hint">Drag to pan · Scroll or use +/− to zoom · Click a marker for details</div>

            <aside class="detail-drawer @(detailArea is null?"closed":"")">
                @if (detailArea is not null)
                {
                    <div class="drawer-handle"></div><button class="drawer-close" aria-label="Close map details" @onclick="()=>detailArea=null">×</button>
                    <span class="eyebrow">@(detailArea==mapArea?"MAP DETAILS":"INSIDE LOCATION")</span><h2>@detailArea.Name</h2>
                    @if (inspectedItem is not null)
                    {
                        <div class="focused-find"><span class="item-gem">◆</span><div><strong>@inspectedItem.Name</strong><small>@inspectedItem.Kind item · X @inspectedItem.X, Y @inspectedItem.Y</small></div><label><input type="checkbox" checked="@CurrentProgress.Collected.Contains(inspectedItem.Id)" @onchange="()=>ToggleItem(inspectedItem.Id)" /> Collected</label></div>
                    }
                    @if (VisibleEncounters.Any())
                    {
                        @foreach(var encounterGroup in EncounterGroups)
                        {
                            <h3>@encounterGroup.Key <small>@encounterGroup.Select(x=>x.SpeciesId).Distinct().Count() species</small></h3>
                            <div class="drawer-grid">@foreach(var mon in encounterGroup.GroupBy(x=>x.SpeciesId).OrderBy(x=>x.First().Species)){var first=mon.First();<button class="mini-find @(CurrentProgress.Caught.Contains(mon.Key)?"done":"")" @onclick="()=>ToggleCaught(mon.Key)"><i>✓</i><img alt="" src="@PokemonIcon(first.SpeciesId)" onerror="@PokemonFallbackScript"/><span><strong>@first.Species</strong><small>@string.Join(" · ",mon.Select(x=>x.Method).Distinct()) · @LevelText(mon) · @ChanceText(mon)</small></span></button>}</div>
                        }
                    }
                    @if (VisibleSpecial.Any())
                    {
                        @foreach(var group in VisibleSpecial.GroupBy(x=>x.Kind).OrderBy(x=>rules.SpecialGroupOrder(x.Key))) { <h3>@(group.Key=="Trade"?"In-game trades":group.Key+" Pokémon")</h3><div class="drawer-grid">@foreach(var mon in group.OrderBy(x=>x.Species)){<button class="mini-find @(CurrentProgress.CompletedSpecial.Contains(mon.Id)?"done":"")" @onclick="()=>ToggleSpecial(mon)"><i>★</i><img alt="" src="@PokemonIcon(mon.SpeciesId)" onerror="@PokemonFallbackScript"/><span><strong>@mon.Species</strong><small>@(mon.Kind=="Trade"?$"For {mon.RequestedSpecies}":$"Lv. {mon.Level}")</small></span></button>}</div> }
                    }
                    @if (detailArea.Items.Any())
                    {
                        @foreach(var group in ItemGroupsFor(detailArea)){<h3>@group.Key items <small>@group.Count()</small></h3><div class="drawer-items">@foreach(var item in group.OrderBy(x=>x.Name)){<label class="@(CurrentProgress.Collected.Contains(item.Id)?"done":"")"><input type="checkbox" checked="@CurrentProgress.Collected.Contains(item.Id)" @onchange="()=>ToggleItem(item.Id)"/><img alt="" src="@ItemIcon(item)" onerror="@ItemFallbackScript"/><span><strong>@item.Name</strong><small>@(item.X<0?"Received from an event":$"X {item.X}, Y {item.Y}")</small></span></label>}</div>}
                    }
                }
            </aside>
        </section>
    </main>
}

@if(interiorOpen && interiorArea is not null)
{
    <div class="interior-backdrop">
        <section class="interior-modal" role="dialog" aria-modal="true" aria-labelledby="interior-title">
            <header><div><span class="eyebrow">INTERIOR MAP</span><h2 id="interior-title">@InteriorTitle</h2></div>@if(InteriorFloors.Count>1){<select aria-label="Interior floor" @onchange="ChangeInterior">@foreach(var floor in InteriorFloors){<option value="@floor.Id" selected="@(floor==interiorArea)">@floor.Name</option>}</select>}<button aria-label="Close interior map" @onclick="()=>interiorOpen=false">×</button></header>
            <div class="interior-body">
                <div class="interior-map"><div class="interior-map-controls"><button aria-label="Zoom interior out" @onclick="()=>ZoomInterior(.8)">−</button><button aria-label="Fit interior map" @onclick="FitInterior">⌖</button><button aria-label="Zoom interior in" @onclick="()=>ZoomInterior(1.25)">+</button></div><div class="interior-canvas" style="width:@(interiorArea.MapWidth)px;height:@(interiorArea.MapHeight)px"><img alt="@InteriorTitle map" src="@interiorArea.MapImage" draggable="false"/>@foreach(var item in interiorArea.Items.Where(x=>x.X>=0)){<button aria-label="@item.Name" class="map-marker @(item.Kind=="Hidden"?"hidden-marker":"item-marker")" style="left:@(item.X*16+8)px;top:@(item.Y*16+8)px" @onclick="()=>InspectInteriorItem(item)"><span>@(item.Kind=="Hidden"?"?":"◆")</span><label>@item.Name@(item.Quantity>1?$" ×{item.Quantity}":"")</label></button>}@foreach(var warp in RelevantEntrancesFor(interiorArea).Where(x=>InteriorFloors.Any(f=>f.Id==x.TargetId))){<button aria-label="Go to @warp.Name" class="map-marker entrance-marker" style="left:@(warp.X*16+8)px;top:@(warp.Y*16+8)px" @onclick="()=>NavigateInterior(warp.TargetId)"><span>⌂</span><label>@warp.Name</label></button>}</div></div>
                <div class="interior-guide">
                    @if(inspectedItem is not null){<div class="focused-find"><img alt="" src="@ItemIcon(inspectedItem)" onerror="@ItemFallbackScript"/><div><strong>@inspectedItem.Name</strong><small>@inspectedItem.Kind item</small></div><label><input type="checkbox" checked="@CurrentProgress.Collected.Contains(inspectedItem.Id)" @onchange="()=>ToggleItem(inspectedItem.Id)"/> Collected</label></div>}
                    @foreach(var encounterGroup in EncounterGroupsFor(interiorArea)){<h3>@encounterGroup.Key</h3><div class="drawer-grid">@foreach(var mon in encounterGroup.GroupBy(x=>x.SpeciesId).OrderBy(x=>x.First().Species)){var first=mon.First();<button class="mini-find @(CurrentProgress.Caught.Contains(mon.Key)?"done":"")" @onclick="()=>ToggleCaught(mon.Key)"><i>✓</i><img alt="" src="@PokemonIcon(first.SpeciesId)" onerror="@PokemonFallbackScript"/><span><strong>@first.Species</strong><small>@LevelText(mon) · @ChanceText(mon)</small></span></button>}</div>}
                    @foreach(var group in interiorArea.SpecialPokemon.Where(x=>x.Version=="Both"||x.Version==progress.Version).GroupBy(x=>x.Kind).OrderBy(x=>rules.SpecialGroupOrder(x.Key))){<h3>@(group.Key=="Trade"?"In-game trades":group.Key+" Pokémon")</h3><div class="drawer-grid">@foreach(var mon in group.OrderBy(x=>x.Species)){<button class="mini-find @(CurrentProgress.CompletedSpecial.Contains(mon.Id)?"done":"")" @onclick="()=>ToggleSpecial(mon)"><i>★</i><img alt="" src="@PokemonIcon(mon.SpeciesId)" onerror="@PokemonFallbackScript"/><span><strong>@mon.Species</strong><small>@(mon.Kind=="Trade"?$"For {mon.RequestedSpecies}":$"Lv. {mon.Level}")</small></span></button>}</div>}
                    @foreach(var group in ItemGroupsFor(interiorArea)){<h3>@group.Key items</h3>@foreach(var item in group.OrderBy(x=>x.Name)){<label class="interior-check @(CurrentProgress.Collected.Contains(item.Id)?"done":"")"><input type="checkbox" checked="@CurrentProgress.Collected.Contains(item.Id)" @onchange="()=>ToggleItem(item.Id)"/><img alt="" src="@ItemIcon(item)" onerror="@ItemFallbackScript"/><span>@item.Name</span></label>}}
                </div>
            </div>
        </section>
    </div>
}

@if(pokedexOpen)
{
    <div class="pokedex-backdrop" @onclick="()=>pokedexOpen=false"><section class="pokedex-modal" role="dialog" aria-modal="true" aria-labelledby="pokedex-title" @onclick:stopPropagation><header><div><span class="eyebrow">@(progress.DexMode.ToUpperInvariant()) POKÉDEX</span><h2 id="pokedex-title">@DexCaughtCount / @VisiblePokedex.Count() caught</h2></div><div class="dex-mode" aria-label="Pokédex type">@foreach(var mode in game!.DexModes){<button class="@(progress.DexMode==mode.Id?"active":"")" @onclick="()=>ChangeDexMode(mode.Id)">@mode.Name</button>}</div><input aria-label="Search Pokédex" placeholder="Search name or number…" @bind="pokedexQuery" @bind:event="oninput"/><button class="dex-close" aria-label="Close Pokédex" @onclick="()=>pokedexOpen=false">×</button></header><div class="pokedex-grid">@foreach(var mon in FilteredPokedex){var caught=CurrentProgress.Caught.Contains(mon.SpeciesId);var availability=PokedexAvailability(mon);<button class="dex-entry @(caught?"caught":"") @(availability=="Obtainable"?"":"unavailable")" @onclick="()=>ToggleCaught(mon.SpeciesId)"><span class="dex-number">#@DexNumber(mon).ToString("D3")</span><img alt="" src="@PokemonIcon(mon.SpeciesId)" onerror="@PokemonFallbackScript"/><span><strong>@mon.Name</strong><small>@(caught?"Caught":availability)</small></span><i>✓</i></button>}</div></section></div>
}

@if(backupOpen)
{
    <div class="modal-backdrop" @onclick="CloseBackup">
        <section class="backup-modal" role="dialog" aria-modal="true" aria-labelledby="backup-title" @onclick:stopPropagation>
            <header><div><span class="eyebrow">SAVE DATA · FORMAT V1</span><h2 id="backup-title">@(backupMode=="export"?"Export backup":"Import backup")</h2></div><button aria-label="Close backup" @onclick="CloseBackup">×</button></header>
            @if(backupMode=="export")
            {
                <p>Choose which games to include. Paired versions keep independent progress while sharing their guide package and assets.</p>
                <div class="backup-games">
                    @foreach(var choice in ExportChoices)
                    {
                        <label><input type="checkbox" checked="@exportProfileKeys.Contains(choice.ProfileKey)" @onchange="e=>ToggleExportProfile(choice.ProfileKey,e)"/><span><strong>@choice.VersionName</strong><small>@choice.PackageName</small></span></label>
                    }
                </div>
                @if(!string.IsNullOrEmpty(backupMessage)){<p class="backup-message success">@backupMessage</p>}
                <footer><button @onclick="CloseBackup">Cancel</button><button class="primary" disabled="@(exportProfileKeys.Count==0)" @onclick="ExportBackup">Download backup</button></footer>
            }
            else
            {
                <p>Select a Pokémon Field Guide backup file. Included game profiles will replace their matching local profiles; unlisted games and your theme are preserved.</p>
                <label class="file-picker"><span>Choose backup file</span><InputFile accept="application/json,.json" OnChange="ImportBackup" /></label>
                @if(!string.IsNullOrEmpty(backupMessage)){<p class="backup-message @(backupError?"error":"success")">@backupMessage</p>}
                <footer><button @onclick="CloseBackup">Close</button></footer>
            }
        </section>
    </div>
}

@if(confirmReset){<div class="modal-backdrop" @onclick="()=>confirmReset=false"><div class="modal" role="dialog" aria-modal="true" aria-labelledby="reset-title" @onclick:stopPropagation><span class="warning">!</span><h2 id="reset-title">Reset all progress?</h2><p>This clears every caught Pokémon and collected item on this device.</p><div><button @onclick="()=>confirmReset=false">Cancel</button><button class="danger" @onclick="Reset">Reset everything</button></div></div></div>}

@code {
    GameCatalog? catalog; GameDefinition? game; IGameRules rules=null!; FieldGuideData? data; List<PokedexEntry> pokedex=[]; List<GuideWorld> worlds=[]; GuideWorld? currentWorld; GameRegionDefinition? currentRegion; GuideArea? mapArea; GuideArea? detailArea; GuideArea? interiorArea; GuideItem? inspectedItem; SavedProgress progress=NewProgress(); string query="",pokedexQuery="",backupMode="export",backupMessage=""; bool confirmReset,searchOpen,interiorOpen,pokedexOpen,menuOpen,backupOpen,backupError; HashSet<string> exportProfileKeys=[]; ElementReference mapViewport; string? initializedMap,initializedInterior,loadError;
    string ProfileKey=>ProfileKeyFor(game!.Id,progress.Version);
    VersionProgress CurrentProgress { get { progress.Profiles??=[];progress.ProfileVersions??=[];if(!progress.Profiles.TryGetValue(ProfileKey,out var profile)){profile=new();progress.Profiles[ProfileKey]=profile;progress.ProfileVersions[ProfileKey]=ActiveVersion.ProgressVersion;}return profile;} }
    GameVersionDefinition ActiveVersion=>game!.Versions.First(version=>version.Id==progress.Version);
    DexModeDefinition ActiveDexMode=>game!.DexModes.FirstOrDefault(mode=>mode.Id==progress.DexMode)??game.DexModes[0];
    string PokemonFallback=>$"{game!.PokemonSpritePath}/question_mark.png";
    string ItemFallback=>$"{game!.ItemSpritePath}/question_mark.png";
    string PokemonFallbackScript=>$"this.src='{PokemonFallback}'";
    string ItemFallbackScript=>$"this.src='{ItemFallback}'";
    string PokedexAvailability(PokedexEntry mon)=>mon.Availability.TryGetValue(progress.Version,out var status)?status:"Trade / transfer required";
    IEnumerable<PokedexEntry> VisiblePokedex=>ActiveDexMode.Regional?pokedex.Where(p=>p.RegionalNumber.HasValue):pokedex;
    IEnumerable<PokedexEntry> FilteredPokedex=>VisiblePokedex.Where(p=>string.IsNullOrWhiteSpace(pokedexQuery)||p.Name.Contains(pokedexQuery,StringComparison.OrdinalIgnoreCase)||DexNumber(p).ToString().Contains(pokedexQuery.Trim()));
    int DexNumber(PokedexEntry mon)=>ActiveDexMode.Regional?mon.RegionalNumber??mon.Number:mon.Number;
    int DexCaughtCount=>VisiblePokedex.Count(p=>CurrentProgress.Caught.Contains(p.SpeciesId));
    IEnumerable<GuideArea> OutdoorAreas => (string.IsNullOrWhiteSpace(query)?currentWorld!.Maps.Select(m=>AreaFor(m.Id)).OfType<GuideArea>():data!.Areas.Where(a=>a.MapImage is not null&&AreaMatchesSearch(a,query))).OrderBy(a=>NaturalKey(a.Name)).Take(80);
    IEnumerable<Encounter> VisibleEncounters => (detailArea?.Encounters??[]).Where(e=>e.Version=="Both"||e.Version==progress.Version);
    IEnumerable<SpecialPokemon> VisibleSpecial => (detailArea?.SpecialPokemon??[]).Where(e=>e.Version=="Both"||e.Version==progress.Version);
    IEnumerable<IGrouping<string,Encounter>> EncounterGroups => GroupEncounters(VisibleEncounters);
    List<GuideArea> InteriorFloors => interiorArea is null?[]:InteriorComponent(interiorArea.Id).OrderBy(a=>NaturalKey(a.Name)).ToList();
    string InteriorTitle=>interiorArea!.Name;
    protected override Task OnInitializedAsync()=>InitializeAsync();
    async Task InitializeAsync()
    {
        loadError=null;
        try
        {
            catalog=await PackageLoader.LoadCatalogAsync();
            progress=await JS.InvokeAsync<SavedProgress?>("fieldGuide.load")??NewProgress();
            game=catalog.Games.FirstOrDefault(choice=>choice.Id==progress.GameId)??catalog.Games.First(choice=>choice.Id==catalog.DefaultGameId);
            progress.GameId=game.Id;
            await LoadGameAsync(game);
            if(MigrateProgress())await Save();
        }
        catch(Exception ex)
        {
            data=null;
            loadError=ex switch
            {
                HttpRequestException=>"The game data could not be downloaded. Check your connection and try again.",
                InvalidOperationException=>ex.Message,
                _=>"The installed game package is invalid or unavailable. Reload the page or try again shortly."
            };
        }
    }
    Task RetryLoad()=>InitializeAsync();
    protected override async Task OnAfterRenderAsync(bool first){if(game is not null){await ApplyAppearance();await JS.InvokeVoidAsync("fieldGuide.applySpriteAnimations",progress.AnimationsEnabled);}if(currentWorld?.Id!=initializedMap){initializedMap=currentWorld?.Id;await JS.InvokeVoidAsync("fieldMap.init",mapViewport);}if(interiorOpen&&interiorArea?.Id!=initializedInterior){initializedInterior=interiorArea?.Id;await JS.InvokeVoidAsync("fieldMap.initInterior");}if(!interiorOpen)initializedInterior=null;}
    async Task LoadGameAsync(GameDefinition definition){var package=await PackageLoader.LoadAsync(definition);game=package.Definition;if(game.Versions.Any(version=>version.ProgressVersion<1))throw new InvalidOperationException($"The {game.Name} package has an invalid progress version.");rules=RulesRegistry.Get(game.Rules);data=package.FieldGuide;pokedex=package.Pokedex;worlds=package.Worlds;progress.SelectedVersions??=[];progress.SelectedDexModes??=[];if(progress.SelectedVersions.TryGetValue(game.Id,out var savedVersion)&&game.Versions.Any(version=>version.Id==savedVersion))progress.Version=savedVersion;else if(!game.Versions.Any(version=>version.Id==progress.Version))progress.Version=game.Versions[0].Id;if(progress.SelectedDexModes.TryGetValue(game.Id,out var savedDexMode)&&game.DexModes.Any(mode=>mode.Id==savedDexMode))progress.DexMode=savedDexMode;else if(!game.DexModes.Any(mode=>mode.Id==progress.DexMode))progress.DexMode=game.DexModes[0].Id;progress.SelectedVersions[game.Id]=progress.Version;progress.SelectedDexModes[game.Id]=progress.DexMode;progress.Accent=ActiveVersion.Accent;currentWorld=worlds.First(world=>world.Id==game.DefaultWorldId);currentRegion=game.Regions.First(region=>region.WorldId==currentWorld.Id);mapArea=AreaFor(game.DefaultAreaId)??data.Areas.First();detailArea=mapArea;interiorArea=null;interiorOpen=false;initializedMap=null;}
    GuideArea? AreaFor(string id)=>data!.Areas.FirstOrDefault(a=>a.Id==rules.NormalizeAreaId(id));
    IEnumerable<IGrouping<string,Encounter>> EncounterGroupsFor(GuideArea area)=>GroupEncounters(area.Encounters.Where(e=>e.Version=="Both"||e.Version==progress.Version));
    IEnumerable<IGrouping<string,Encounter>> GroupEncounters(IEnumerable<Encounter> rows)=>rows.GroupBy(rules.EncounterGroupName).OrderBy(g=>rules.EncounterGroupOrder(g.Key));
    IEnumerable<IGrouping<string,GuideItem>> ItemGroupsFor(GuideArea area)=>area.Items.GroupBy(x=>x.Kind).OrderBy(x=>rules.ItemGroupOrder(x.Key));
    bool AreaMatchesSearch(GuideArea area,string search)
    {
        var term=search.Trim();
        bool Matches(string? value)=>value?.Contains(term,StringComparison.OrdinalIgnoreCase)==true;
        return Matches(area.Name)
            ||Matches(area.Region)
            ||area.Items.Any(item=>Matches(item.Name)||Matches(item.Kind))
            ||area.Encounters.Any(encounter=>(encounter.Version=="Both"||encounter.Version==progress.Version)&&(Matches(encounter.Species)||Matches(encounter.Method)))
            ||area.SpecialPokemon.Any(mon=>(mon.Version=="Both"||mon.Version==progress.Version)&&(Matches(mon.Species)||Matches(mon.Kind)||Matches(mon.RequestedSpecies)))
            ||area.Entrances.Any(entrance=>Matches(entrance.Name));
    }
    IEnumerable<DisplayEntrance> RelevantEntrancesFor(GuideArea area)
    {
        var resolved=area.Entrances.Select(e=>(Warp:e,Target:ResolveRelevantTarget(area.Id,e.TargetId))).Where(x=>x.Target is not null).Select(x=>new DisplayEntrance(x.Target!.Id,x.Target.Name,x.Warp.X,x.Warp.Y)).ToList();
        foreach(var targetGroup in resolved.GroupBy(x=>x.TargetId))
        {
            var remaining=targetGroup.ToList();
            while(remaining.Count>0)
            {
                var cluster=new List<DisplayEntrance>{remaining[0]};remaining.RemoveAt(0);
                for(var i=0;i<cluster.Count;i++) for(var j=remaining.Count-1;j>=0;j--) if(Math.Abs(cluster[i].X-remaining[j].X)<=1&&Math.Abs(cluster[i].Y-remaining[j].Y)<=1){cluster.Add(remaining[j]);remaining.RemoveAt(j);}
                yield return new DisplayEntrance(targetGroup.Key,cluster[0].Name,cluster.Average(x=>x.X),cluster.Average(x=>x.Y));
            }
        }
    }
    GuideArea? ResolveRelevantTarget(string sourceId,string targetId)
    {
        var queue=new Queue<string>();var visited=new HashSet<string>{sourceId};if(!string.IsNullOrEmpty(targetId))queue.Enqueue(targetId);
        while(queue.Count>0){var id=queue.Dequeue();if(!visited.Add(id))continue;var area=AreaFor(id);if(area is null)continue;if(IsOutdoor(id))continue;if(area.Items.Count+area.SpecialPokemon.Count+area.Encounters.Count>0)return area;foreach(var exit in area.Entrances)if(!visited.Contains(exit.TargetId))queue.Enqueue(exit.TargetId);}
        return null;
    }
    bool IsOutdoor(string id)=>worlds.Any(world=>world.Maps.Any(map=>rules.NormalizeAreaId(map.Id)==rules.NormalizeAreaId(id)));
    IEnumerable<GuideArea> InteriorComponent(string startId)
    {
        var queue=new Queue<string>();var visited=new HashSet<string>();queue.Enqueue(startId);
        while(queue.Count>0){var id=queue.Dequeue();if(!visited.Add(id)||IsOutdoor(id))continue;var area=AreaFor(id);if(area is null)continue;if(area.Items.Count+area.SpecialPokemon.Count+area.Encounters.Count>0)yield return area;foreach(var exit in area.Entrances)if(!string.IsNullOrEmpty(exit.TargetId)&&!visited.Contains(exit.TargetId))queue.Enqueue(exit.TargetId);}
    }
