@page "/"
@inject IJSRuntime JS
@inject GamePackageLoader PackageLoader

<PageTitle>@(game?.PageTitle ?? "Pokémon Field Guide")</PageTitle>

<header class="topbar">
    <div class="brand"><span class="brand-ball">●</span><div><strong>POKEMON FIELD GUIDE</strong><small>@(game is null ? "INTERACTIVE MAP ATLAS" : $"Pokémon {ActiveVersion.Name}")</small></div></div>
    <div class="top-actions">
        <button class="header-icon desktop-dex" aria-label="Open Pokédex" @onclick="OpenPokedex"><span aria-hidden="true">▦</span></button>
        <button class="header-menu-button" aria-label="Open menu" aria-expanded="@menuOpen" @onclick="()=>menuOpen=!menuOpen"><span aria-hidden="true">☰</span><span>Menu</span></button>
        @if(menuOpen)
        {
            <button class="menu-scrim" aria-label="Close menu" @onclick="()=>menuOpen=false"></button>
            <section class="header-menu" aria-label="Application menu">
                <button class="menu-row mobile-dex" @onclick="OpenPokedex"><span>▦</span> Pokédex</button>
                <label>GAME<select value="@(game is null?null:$"{game.Id}|{progress.Version}")" @onchange="ChangePlayableGame">@foreach(var package in catalog?.Games??[]){@foreach(var version in package.Versions){<option value="@($"{package.Id}|{version.Id}")">Pokémon @version.Name</option>}}</select></label>
                <button class="menu-row" @onclick="ToggleTheme"><span>@(progress.Theme=="Dark"?"☀":"◐")</span> @(progress.Theme=="Dark"?"Use light mode":"Use dark mode")</button>
                <button class="menu-row" @onclick="ToggleAnimations"><span>@(progress.AnimationsEnabled?"⏸":"▶")</span> @(progress.AnimationsEnabled?"Disable sprite animations":"Enable sprite animations")</button>
                <div class="menu-separator"></div>
                <button class="menu-row" @onclick="OpenExport"><span>⇩</span> Export save data</button>
                <button class="menu-row" @onclick="OpenImport"><span>⇧</span> Import save data</button>
                <div class="menu-separator"></div>
                <button class="menu-row danger-row" @onclick="OpenReset"><span>!</span> Reset progress</button>
            </section>
        }
    </div>
</header>

@if (gamePackage is null && loadError is null) { <main class="loading-card">Rendering the map…</main> }
else if (gamePackage is null)
{
    <main class="loading-card load-error" role="alert">
        <strong>The field guide could not be loaded.</strong>
        <span>@loadError</span>
        <button @onclick="RetryLoad">Try again</button>
    </main>
}
else
{
    <main class="atlas-shell">
        <aside class="atlas-sidebar">
            <div class="atlas-heading"><span class="eyebrow">WORLD MAP</span><h1>@game?.AtlasTitle</h1></div>
            <div class="search"><span>⌕</span><input aria-label="Search locations and their contents" placeholder="Search locations, Pokémon, items…" value="@query" @oninput="SearchChanged" @onfocus="()=>searchOpen=true" /></div>
            @if(game?.Regions.Count > 1){<div class="map-filters">@foreach(var choice in game.Regions){<button class="@(currentRegion?.Id==choice.Id?"active":"")" @onclick="()=>ShowRegion(choice)">@choice.Name</button>}</div>}
            <nav class="outdoor-list @(!searchOpen?"closed":"")">
                @foreach (var area in OutdoorAreas)
                {
                    <button class="outdoor-row @(area==mapArea?"active":"")" @onclick="()=>SelectSearchArea(area)"><span><strong>@area.Name</strong><small>@area.Items.Count items · @(IsOutdoor(area.Id)?$"{RelevantEntrancesFor(area).Count()} entrances":"interior map")</small></span><b>@AreaPercent(area)%</b></button>
                }
            </nav>
            <div class="legend"><span><i class="legend-pin item-pin">◆</i> Item</span><span><i class="legend-pin hidden-pin">?</i> Hidden</span><span><i class="legend-pin door-pin">⌂</i> Entrance</span></div>
        </aside>

        <section class="map-stage">
            <div class="map-toolbar @(detailArea is not null?"panel-open":"")">
                <div><span class="eyebrow">CONNECTED WORLD / EXPLORE</span><h2>@currentRegion?.Name</h2></div>
                <div class="zoom-controls"><button aria-label="Zoom out" @onclick="()=>Zoom(.8)">−</button><button aria-label="Fit world map" @onclick="ResetView">⌖</button><button aria-label="Zoom in" @onclick="()=>Zoom(1.25)">+</button></div>
            </div>
            @if (currentWorld is not null)
            {
                <div class="map-viewport" @ref="mapViewport">
                    <div class="map-world" style="width:@(currentWorld.Width)px;height:@(currentWorld.Height)px">
                        <img src="@currentWorld.Image" alt="@(currentWorld.Id) connected game world" draggable="false" />
                        @foreach (var placement in currentWorld.Maps)
                        {
                            var area = AreaFor(placement.Id);
                            if (area is not null)
                            {
                                <button class="area-hotspot @(area==mapArea?"selected":"")" aria-label="@area.Name" style="left:@(placement.X)px;top:@(placement.Y)px;width:@(placement.Width)px;height:@(placement.Height)px" @onclick="()=>SelectArea(area)"></button>
                                @foreach (var item in area.Items.Where(item => item.X >= 0 && item.Y >= 0))
                                {
                                    <button aria-label="@item.Name — @item.Kind item" style="left:@(placement.X+(item.X-placement.MarkerOffsetX)*16+8)px;top:@(placement.Y+(item.Y-placement.MarkerOffsetY)*16+8)px" class="map-marker @(item.Kind=="Hidden"?"hidden-marker":"item-marker") @(CurrentProgress.Collected.Contains(item.Id)?"done":"")" @onclick="()=>InspectItem(area,item)"><span>@(item.Kind=="Hidden"?"?":"◆")</span><label>@area.Name · @item.Name</label></button>
                                }
                                @foreach (var entrance in RelevantEntrancesFor(area))
                                {
                                    <button aria-label="Enter @entrance.Name" style="left:@(placement.X+(entrance.X-placement.MarkerOffsetX)*16+8)px;top:@(placement.Y+(entrance.Y-placement.MarkerOffsetY)*16+8)px" class="map-marker entrance-marker" @onclick="()=>OpenEntrance(entrance.TargetId)"><span>⌂</span><label>@area.Name · @entrance.Name</label></button>
                                }
                            }
                        }
                    </div>
                </div>
            }
            <div class="map-hint">Drag to pan · Scroll or use +/− to zoom · Click a marker for details</div>

            <aside class="detail-drawer @(detailArea is null?"closed":"")">
                @if (detailArea is not null)
                {
                    <div class="drawer-handle"></div><button class="drawer-close" aria-label="Close map details" @onclick="()=>detailArea=null">×</button>
                    <span class="eyebrow">@(detailArea==mapArea?"MAP DETAILS":"INSIDE LOCATION")</span><h2>@detailArea.Name</h2>
                    @if (inspectedItem is not null)
                    {
                        <div class="focused-find"><span class="item-gem">◆</span><div><strong>@inspectedItem.Name</strong><small>@inspectedItem.Kind item · X @inspectedItem.X, Y @inspectedItem.Y</small></div><label><input type="checkbox" checked="@CurrentProgress.Collected.Contains(inspectedItem.Id)" @onchange="()=>ToggleItem(inspectedItem.Id)" /> Collected</label></div>
                    }
                    @if (EncounterGroups.Any())
                    {
                        @foreach(var encounterGroup in EncounterGroups)
                        {
                            <h3>@encounterGroup.Name <small>@encounterGroup.Encounters.Select(x=>x.SpeciesId).Distinct().Count() species</small></h3>
                            <div class="drawer-grid">@foreach(var mon in encounterGroup.Encounters.GroupBy(x=>x.SpeciesId).OrderBy(x=>x.First().Species)){var first=mon.First();<button class="mini-find @(CurrentProgress.Caught.Contains(mon.Key)?"done":"")" @onclick="()=>ToggleCaught(mon.Key)"><i>✓</i><img alt="" src="@PokemonIcon(first.SpeciesId)" onerror="@PokemonFallbackScript"/><span><strong>@first.Species</strong><small>@string.Join(" · ",mon.Select(x=>x.Method).Distinct()) · @LevelText(mon) · @ChanceText(mon)</small></span></button>}</div>
                        }
                    }
                    @if (SpecialPokemonGroups.Any())
                    {
                        @foreach(var group in SpecialPokemonGroups) { <h3>@(group.Kind=="Trade"?"In-game trades":group.Kind+" Pokémon")</h3><div class="drawer-grid">@foreach(var mon in group.Pokemon.OrderBy(x=>x.Species)){<button class="mini-find @(CurrentProgress.CompletedSpecial.Contains(mon.Id)?"done":"")" @onclick="()=>ToggleSpecial(mon)"><i>★</i><img alt="" src="@PokemonIcon(mon.SpeciesId)" onerror="@PokemonFallbackScript"/><span><strong>@mon.Species</strong><small>@(mon.Kind=="Trade"?$"For {mon.RequestedSpecies}":$"Lv. {mon.Level}")</small></span></button>}</div> }
                    }
                    @if (detailArea.Items.Any())
                    {
                        @foreach(var group in ItemGroupsFor(detailArea)){<h3>@group.Kind items <small>@group.Items.Count</small></h3><div class="drawer-items">@foreach(var item in group.Items.OrderBy(x=>x.Name)){<label class="@(CurrentProgress.Collected.Contains(item.Id)?"done":"")"><input type="checkbox" checked="@CurrentProgress.Collected.Contains(item.Id)" @onchange="()=>ToggleItem(item.Id)"/><img alt="" src="@ItemIcon(item)" onerror="@ItemFallbackScript"/><span><strong>@item.Name</strong><small>@(item.X<0?"Received from an event":$"X {item.X}, Y {item.Y}")</small></span></label>}</div>}
                    }
                }
            </aside>
        </section>
    </main>
}

@if(interiorOpen && interiorArea is not null)
{
    <div class="interior-backdrop">
        <section class="interior-modal" role="dialog" aria-modal="true" aria-labelledby="interior-title">
            <header><div><span class="eyebrow">INTERIOR MAP</span><h2 id="interior-title">@InteriorTitle</h2></div>@if(InteriorFloors.Count>1){<select aria-label="Interior floor" @onchange="ChangeInterior">@foreach(var floor in InteriorFloors){<option value="@floor.Id" selected="@(floor==interiorArea)">@floor.Name</option>}</select>}<button aria-label="Close interior map" @onclick="()=>interiorOpen=false">×</button></header>
            <div class="interior-body">
                <div class="interior-map"><div class="interior-map-controls"><button aria-label="Zoom interior out" @onclick="()=>ZoomInterior(.8)">−</button><button aria-label="Fit interior map" @onclick="FitInterior">⌖</button><button aria-label="Zoom interior in" @onclick="()=>ZoomInterior(1.25)">+</button></div><div class="interior-canvas" style="width:@(interiorArea.MapWidth)px;height:@(interiorArea.MapHeight)px"><img alt="@InteriorTitle map" src="@interiorArea.MapImage" draggable="false"/>@foreach(var item in interiorArea.Items.Where(x=>x.X>=0)){<button aria-label="@item.Name" class="map-marker @(item.Kind=="Hidden"?"hidden-marker":"item-marker") @(CurrentProgress.Collected.Contains(item.Id)?"done":"")" style="left:@(item.X*16+8)px;top:@(item.Y*16+8)px" @onclick="()=>InspectInteriorItem(item)"><span>@(item.Kind=="Hidden"?"?":"◆")</span><label>@item.Name@(item.Quantity>1?$" ×{item.Quantity}":"")</label></button>}@foreach(var warp in RelevantEntrancesFor(interiorArea).Where(x=>InteriorFloors.Any(f=>f.Id==x.TargetId))){<button aria-label="Go to @warp.Name" class="map-marker entrance-marker" style="left:@(warp.X*16+8)px;top:@(warp.Y*16+8)px" @onclick="()=>NavigateInterior(warp.TargetId)"><span>⌂</span><label>@warp.Name</label></button>}</div></div>
                <div class="interior-guide">
                    @if(inspectedItem is not null){<div class="focused-find"><img alt="" src="@ItemIcon(inspectedItem)" onerror="@ItemFallbackScript"/><div><strong>@inspectedItem.Name</strong><small>@inspectedItem.Kind item</small></div><label><input type="checkbox" checked="@CurrentProgress.Collected.Contains(inspectedItem.Id)" @onchange="()=>ToggleItem(inspectedItem.Id)"/> Collected</label></div>}
                    @foreach(var encounterGroup in EncounterGroupsFor(interiorArea)){<h3>@encounterGroup.Name</h3><div class="drawer-grid">@foreach(var mon in encounterGroup.Encounters.GroupBy(x=>x.SpeciesId).OrderBy(x=>x.First().Species)){var first=mon.First();<button class="mini-find @(CurrentProgress.Caught.Contains(mon.Key)?"done":"")" @onclick="()=>ToggleCaught(mon.Key)"><i>✓</i><img alt="" src="@PokemonIcon(first.SpeciesId)" onerror="@PokemonFallbackScript"/><span><strong>@first.Species</strong><small>@LevelText(mon) · @ChanceText(mon)</small></span></button>}</div>}
                    @foreach(var group in SpecialPokemonGroupsFor(interiorArea)){<h3>@(group.Kind=="Trade"?"In-game trades":group.Kind+" Pokémon")</h3><div class="drawer-grid">@foreach(var mon in group.Pokemon.OrderBy(x=>x.Species)){<button class="mini-find @(CurrentProgress.CompletedSpecial.Contains(mon.Id)?"done":"")" @onclick="()=>ToggleSpecial(mon)"><i>★</i><img alt="" src="@PokemonIcon(mon.SpeciesId)" onerror="@PokemonFallbackScript"/><span><strong>@mon.Species</strong><small>@(mon.Kind=="Trade"?$"For {mon.RequestedSpecies}":$"Lv. {mon.Level}")</small></span></button>}</div>}
                    @foreach(var group in ItemGroupsFor(interiorArea)){<h3>@group.Kind items</h3>@foreach(var item in group.Items.OrderBy(x=>x.Name)){<label class="interior-check @(CurrentProgress.Collected.Contains(item.Id)?"done":"")"><input type="checkbox" checked="@CurrentProgress.Collected.Contains(item.Id)" @onchange="()=>ToggleItem(item.Id)"/><img alt="" src="@ItemIcon(item)" onerror="@ItemFallbackScript"/><span>@item.Name</span></label>}}
                </div>
            </div>
        </section>
    </div>
}

@if(pokedexOpen)
{
    <div class="pokedex-backdrop" @onclick="()=>pokedexOpen=false"><section class="pokedex-modal" role="dialog" aria-modal="true" aria-labelledby="pokedex-title" @onclick:stopPropagation><header><div><span class="eyebrow">@(progress.DexMode.ToUpperInvariant()) POKÉDEX</span><h2 id="pokedex-title">@DexCaughtCount / @VisiblePokedex.Count caught</h2></div><div class="dex-mode" aria-label="Pokédex type">@foreach(var mode in game!.DexModes){<button class="@(progress.DexMode==mode.Id?"active":"")" @onclick="()=>ChangeDexMode(mode.Id)">@mode.Name</button>}</div><input aria-label="Search Pokédex" placeholder="Search name or number…" @bind="pokedexQuery" @bind:event="oninput"/><button class="dex-close" aria-label="Close Pokédex" @onclick="()=>pokedexOpen=false">×</button></header><div class="pokedex-grid">@foreach(var result in FilteredPokedex){var mon=result.Entry;var caught=CurrentProgress.Caught.Contains(mon.SpeciesId);<button class="dex-entry @(caught?"caught":"") @(result.Availability=="Obtainable"?"":"unavailable")" @onclick="()=>ToggleCaught(mon.SpeciesId)"><span class="dex-number">#@result.Number.ToString("D3")</span><img alt="" src="@PokemonIcon(mon.SpeciesId)" onerror="@PokemonFallbackScript"/><span><strong>@mon.Name</strong><small>@(caught?"Caught":result.Availability)</small></span><i>✓</i></button>}</div></section></div>
}

@if(backupOpen)
{
    <div class="modal-backdrop" @onclick="CloseBackup">
        <section class="backup-modal" role="dialog" aria-modal="true" aria-labelledby="backup-title" @onclick:stopPropagation>
            <header><div><span class="eyebrow">SAVE DATA · FORMAT V1</span><h2 id="backup-title">@(backupMode=="export"?"Export backup":"Import backup")</h2></div><button aria-label="Close backup" @onclick="CloseBackup">×</button></header>
            @if(backupMode=="export")
            {
                <p>Choose which games to include. Paired versions keep independent progress while sharing their guide package and assets.</p>
                <div class="backup-games">
                    @foreach(var choice in ExportChoices)
                    {
                        <label><input type="checkbox" checked="@exportProfileKeys.Contains(choice.ProfileKey)" @onchange="e=>ToggleExportProfile(choice.ProfileKey,e)"/><span><strong>@choice.VersionName</strong><small>@choice.PackageName</small></span></label>
                    }
                </div>
                @if(!string.IsNullOrEmpty(backupMessage)){<p class="backup-message success">@backupMessage</p>}
                <footer><button @onclick="CloseBackup">Cancel</button><button class="primary" disabled="@(exportProfileKeys.Count==0)" @onclick="ExportBackup">Download backup</button></footer>
            }
            else
            {
                <p>Select a Pokémon Field Guide backup file. Included game profiles will replace their matching local profiles; unlisted games and your theme are preserved.</p>
                <label class="file-picker"><span>Choose backup file</span><InputFile accept="application/json,.json" OnChange="ImportBackup" /></label>
                @if(!string.IsNullOrEmpty(backupMessage)){<p class="backup-message @(backupError?"error":"success")">@backupMessage</p>}
                <footer><button @onclick="CloseBackup">Close</button></footer>
            }
        </section>
    </div>
}

@if(confirmReset){<div class="modal-backdrop" @onclick="()=>confirmReset=false"><div class="modal" role="dialog" aria-modal="true" aria-labelledby="reset-title" @onclick:stopPropagation><span class="warning">!</span><h2 id="reset-title">Reset all progress?</h2><p>This clears every caught Pokémon and collected item on this device.</p><div><button @onclick="()=>confirmReset=false">Cancel</button><button class="danger" @onclick="Reset">Reset everything</button></div></div></div>}

@code {
    GameCatalog? catalog; GamePackage? gamePackage; GameDefinition? game; GuideWorld? currentWorld; GameRegionDefinition? currentRegion; GuideArea? mapArea; GuideArea? detailArea; GuideArea? interiorArea; GuideItem? inspectedItem; SavedProgress progress=NewProgress(); string query="",pokedexQuery="",backupMode="export",backupMessage=""; bool confirmReset,searchOpen,interiorOpen,pokedexOpen,menuOpen,backupOpen,backupError; HashSet<string> exportProfileKeys=[]; ElementReference mapViewport; string? initializedMap,initializedInterior,loadError;
    string ProfileKey=>ProfileKeyFor(game!.Id,progress.Version);
    VersionProgress CurrentProgress { get { progress.Profiles??=[];progress.ProfileVersions??=[];if(!progress.Profiles.TryGetValue(ProfileKey,out var profile)){profile=new();progress.Profiles[ProfileKey]=profile;progress.ProfileVersions[ProfileKey]=ActiveVersion.ProgressVersion;}return profile;} }
    GameVersionDefinition ActiveVersion=>game!.Versions.First(version=>version.Id==progress.Version);
    string PokemonFallback=>gamePackage!.PokemonFallback;
    string ItemFallback=>gamePackage!.ItemFallback;
    string PokemonFallbackScript=>$"this.src='{PokemonFallback}'";
    string ItemFallbackScript=>$"this.src='{ItemFallback}'";
    IReadOnlyList<PokedexResult> VisiblePokedex=>gamePackage!.SearchPokedex(progress.DexMode,progress.Version,"");
    IReadOnlyList<PokedexResult> FilteredPokedex=>gamePackage!.SearchPokedex(progress.DexMode,progress.Version,pokedexQuery);
    int DexCaughtCount=>VisiblePokedex.Count(result=>CurrentProgress.Caught.Contains(result.Entry.SpeciesId));
    IReadOnlyList<GuideArea> OutdoorAreas=>string.IsNullOrWhiteSpace(query)?gamePackage!.AreasForWorld(currentWorld!.Id):gamePackage!.SearchAreas(query,progress.Version);
    IReadOnlyList<EncounterGroup> EncounterGroups=>detailArea is null?[]:gamePackage!.EncounterGroups(detailArea,progress.Version);
    IReadOnlyList<SpecialPokemonGroup> SpecialPokemonGroups=>detailArea is null?[]:gamePackage!.SpecialPokemonGroups(detailArea,progress.Version);
    IReadOnlyList<GuideArea> InteriorFloors=>interiorArea is null?[]:gamePackage!.InteriorFloors(interiorArea.Id);
    string InteriorTitle=>interiorArea!.Name;
    protected override Task OnInitializedAsync()=>InitializeAsync();
    async Task InitializeAsync()
    {
        loadError=null;
        try
        {
            catalog=await PackageLoader.LoadCatalogAsync();
            progress=await JS.InvokeAsync<SavedProgress?>("fieldGuide.load")??NewProgress();
            game=catalog.Games.FirstOrDefault(choice=>choice.Id==progress.GameId)??catalog.Games.First(choice=>choice.Id==catalog.DefaultGameId);
            progress.GameId=game.Id;
            await LoadGameAsync(game);
            if(MigrateProgress())await Save();
        }
        catch(Exception ex)
        {
            gamePackage=null;
            loadError=ex switch
            {
                HttpRequestException=>"The game data could not be downloaded. Check your connection and try again.",
                InvalidOperationException=>ex.Message,
                _=>"The installed game package is invalid or unavailable. Reload the page or try again shortly."
            };
        }
    }
    Task RetryLoad()=>InitializeAsync();
    protected override async Task OnAfterRenderAsync(bool first){if(game is not null){await ApplyAppearance();await JS.InvokeVoidAsync("fieldGuide.applySpriteAnimations",progress.AnimationsEnabled);}if(currentWorld?.Id!=initializedMap){initializedMap=currentWorld?.Id;await JS.InvokeVoidAsync("fieldMap.init",mapViewport);}if(interiorOpen&&interiorArea?.Id!=initializedInterior){initializedInterior=interiorArea?.Id;await JS.InvokeVoidAsync("fieldMap.initInterior");}if(!interiorOpen)initializedInterior=null;}
    async Task LoadGameAsync(GameDefinition definition){gamePackage=await PackageLoader.LoadAsync(definition);game=gamePackage.Definition;progress.SelectedVersions??=[];progress.SelectedDexModes??=[];if(progress.SelectedVersions.TryGetValue(game.Id,out var savedVersion)&&game.Versions.Any(version=>version.Id==savedVersion))progress.Version=savedVersion;else if(!game.Versions.Any(version=>version.Id==progress.Version))progress.Version=game.Versions[0].Id;if(progress.SelectedDexModes.TryGetValue(game.Id,out var savedDexMode)&&game.DexModes.Any(mode=>mode.Id==savedDexMode))progress.DexMode=savedDexMode;else if(!game.DexModes.Any(mode=>mode.Id==progress.DexMode))progress.DexMode=game.DexModes[0].Id;progress.SelectedVersions[game.Id]=progress.Version;progress.SelectedDexModes[game.Id]=progress.DexMode;progress.Accent=ActiveVersion.Accent;currentWorld=gamePackage.DefaultWorld;currentRegion=game.Regions.First(region=>region.WorldId==currentWorld.Id);mapArea=gamePackage.DefaultArea;detailArea=mapArea;interiorArea=null;interiorOpen=false;initializedMap=null;}
    GuideArea? AreaFor(string id)=>gamePackage!.Area(id);
    IReadOnlyList<EncounterGroup> EncounterGroupsFor(GuideArea area)=>gamePackage!.EncounterGroups(area,progress.Version);
    IReadOnlyList<ItemGroup> ItemGroupsFor(GuideArea area)=>gamePackage!.ItemGroups(area);
    IReadOnlyList<SpecialPokemonGroup> SpecialPokemonGroupsFor(GuideArea area)=>gamePackage!.SpecialPokemonGroups(area,progress.Version);
    IReadOnlyList<DisplayEntrance> RelevantEntrancesFor(GuideArea area)=>gamePackage!.RelevantEntrances(area);
    bool IsOutdoor(string id)=>gamePackage!.IsOutdoor(id);
    void SearchChanged(ChangeEventArgs e){query=e.Value?.ToString()??"";searchOpen=true;}
    void SelectArea(GuideArea area){mapArea=area;detailArea=area;inspectedItem=null;searchOpen=false;query="";}
    void SelectSearchArea(GuideArea area){if(IsOutdoor(area.Id)){var world=gamePackage!.WorldForArea(area.Id);if(world is not null&&world!=currentWorld){currentWorld=world;currentRegion=game!.Regions.First(region=>region.WorldId==world.Id);initializedMap=null;}SelectArea(area);}else{OpenEntrance(area.Id);searchOpen=false;query="";}}
    void ShowRegion(GameRegionDefinition selected){currentRegion=selected;currentWorld=gamePackage!.World(selected.WorldId);initializedMap=null;}
    void OpenEntrance(string targetId){interiorArea=gamePackage!.Area(targetId);if(interiorArea is not null){interiorOpen=true;inspectedItem=null;}}
    void InspectItem(GuideArea area,GuideItem item){mapArea=area;detailArea=area;inspectedItem=item;}
    void InspectInteriorItem(GuideItem item)=>inspectedItem=item; void NavigateInterior(string targetId){interiorArea=gamePackage!.Area(targetId)??interiorArea;inspectedItem=null;} void ChangeInterior(ChangeEventArgs e){interiorArea=gamePackage!.Area((string?)e.Value??"")??interiorArea;inspectedItem=null;}
    async Task Zoom(double z)=>await JS.InvokeVoidAsync("fieldMap.zoom",mapViewport,z); async Task ResetView()=>await JS.InvokeVoidAsync("fieldMap.reset",mapViewport);
    async Task ZoomInterior(double z)=>await JS.InvokeVoidAsync("fieldMap.zoomInterior",z); async Task FitInterior()=>await JS.InvokeVoidAsync("fieldMap.fitInterior");
    bool MigrateProgress()
    {
        progress.Profiles??=[];progress.ProfileVersions??=[];var changed=false;
        if(progress.FormatVersion!=SavedProgress.CurrentFormatVersion)throw new InvalidOperationException($"Local save format v{progress.FormatVersion} is not supported by this guide.");
        foreach(var definition in catalog!.Games)foreach(var version in definition.Versions)
        {
            var key=ProfileKeyFor(definition.Id,version.Id);if(!progress.Profiles.TryGetValue(key,out var profile))continue;
            if(!progress.ProfileVersions.TryGetValue(key,out var storedVersion))throw new InvalidOperationException($"The {version.Name} local save profile is missing its data version.");
            progress.Profiles[key]=MigrateProfile(definition.Id,version.Id,storedVersion,version.ProgressVersion,profile);
            if(storedVersion!=version.ProgressVersion){progress.ProfileVersions[key]=version.ProgressVersion;changed=true;}
        }
        return changed;
    }
    async Task Save()=>await JS.InvokeVoidAsync("fieldGuide.save",progress); async Task ToggleItem(string id){if(!CurrentProgress.Collected.Add(id))CurrentProgress.Collected.Remove(id);await Save();} async Task ToggleCaught(string id){if(!CurrentProgress.Caught.Add(id))CurrentProgress.Caught.Remove(id);await Save();} async Task ToggleSpecial(SpecialPokemon m){if(!CurrentProgress.CompletedSpecial.Add(m.Id))CurrentProgress.CompletedSpecial.Remove(m.Id);CurrentProgress.Caught.Add(m.SpeciesId);await Save();}
    async Task ChangeGame(ChangeEventArgs e){var selected=catalog!.Games.FirstOrDefault(choice=>choice.Id==(string?)e.Value);if(selected is null)return;progress.GameId=selected.Id;await LoadGameAsync(selected);await Save();await ApplyAppearance();}
    async Task ChangeVersion(ChangeEventArgs e){var selected=(string?)e.Value;if(selected is null||!game!.Versions.Any(version=>version.Id==selected))return;progress.Version=selected;progress.SelectedVersions[game.Id]=selected;progress.Accent=ActiveVersion.Accent;await Save();await ApplyAppearance();}
    async Task ChangePlayableGame(ChangeEventArgs e)
    {
        var parts=((string?)e.Value)?.Split('|',2);if(parts?.Length!=2)return;
        var definition=catalog!.Games.FirstOrDefault(choice=>choice.Id==parts[0]);if(definition is null||!definition.Versions.Any(version=>version.Id==parts[1]))return;
        if(game?.Id!=definition.Id){progress.GameId=definition.Id;await LoadGameAsync(definition);}
        progress.Version=parts[1];progress.SelectedVersions[definition.Id]=parts[1];progress.Accent=ActiveVersion.Accent;await Save();await ApplyAppearance();
    }
    async Task ChangeDexMode(string mode){progress.DexMode=mode;progress.SelectedDexModes[game!.Id]=mode;pokedexQuery="";await Save();}
    async Task ToggleTheme(){progress.Theme=progress.Theme=="Dark"?"Light":"Dark";await Save();await ApplyAppearance();}
    async Task ToggleAnimations(){progress.AnimationsEnabled=!progress.AnimationsEnabled;await Save();await JS.InvokeVoidAsync("fieldGuide.applySpriteAnimations",progress.AnimationsEnabled);}
    void OpenPokedex(){menuOpen=false;pokedexOpen=true;}
    void OpenReset(){menuOpen=false;confirmReset=true;}
    IEnumerable<ExportProfileChoice> ExportChoices=>catalog!.Games.SelectMany(package=>package.Versions.Select(version=>new ExportProfileChoice(ProfileKeyFor(package.Id,version.Id),package.Name,version.Name)));
    void OpenExport(){menuOpen=false;backupMode="export";backupMessage="";backupError=false;exportProfileKeys=[..ExportChoices.Select(x=>x.ProfileKey)];backupOpen=true;}
    void OpenImport(){menuOpen=false;backupMode="import";backupMessage="";backupError=false;backupOpen=true;}
    void CloseBackup(){backupOpen=false;backupMessage="";}
    void ToggleExportProfile(string profileKey,ChangeEventArgs e){if(e.Value is true)exportProfileKeys.Add(profileKey);else exportProfileKeys.Remove(profileKey);}
    async Task ExportBackup()
    {
        var backup=new SaveBackup();
        foreach(var definition in catalog!.Games)
        {
            var versions=definition.Versions.Where(version=>exportProfileKeys.Contains(ProfileKeyFor(definition.Id,version.Id))).ToList();
            if(versions.Count==0)continue;
            var preferredVersion=progress.SelectedVersions.GetValueOrDefault(definition.Id,versions[0].Id);
            var selectedVersion=versions.Any(version=>version.Id==preferredVersion)?preferredVersion:versions[0].Id;
            var selectedDexMode=progress.SelectedDexModes.GetValueOrDefault(definition.Id,definition.DexModes[0].Id);
            var gameBackup=new GameSaveBackup{SelectedVersion=selectedVersion,SelectedDexMode=selectedDexMode};
            foreach(var version in versions)
            {
                gameBackup.Profiles[version.Id]=progress.Profiles.TryGetValue(ProfileKeyFor(definition.Id,version.Id),out var profile)?CloneProfile(profile):new();
                gameBackup.ProfileVersions[version.Id]=version.ProgressVersion;
            }
            backup.Games[definition.Id]=gameBackup;
        }
        await JS.InvokeVoidAsync("fieldGuide.download",$"pokemon-field-guide-v1-{DateTime.UtcNow:yyyy-MM-dd}.json",backup);
        backupMessage="Backup downloaded.";
    }
    async Task ImportBackup(InputFileChangeEventArgs e)
    {
        backupMessage="";backupError=false;
        try
        {
            await using var stream=e.File.OpenReadStream(2*1024*1024);
            var backup=await System.Text.Json.JsonSerializer.DeserializeAsync<SaveBackup>(stream,new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web));
            if(backup is null||backup.Format!=SaveBackup.CurrentFormat)throw new InvalidOperationException("This is not a Pokémon Field Guide backup.");
            if(backup.FormatVersion!=SaveBackup.CurrentVersion)throw new InvalidOperationException($"Backup format v{backup.FormatVersion} is not supported by this version of the guide.");
            var imported=ImportV0(backup);
            if(imported.PackageIds.Count==0)throw new InvalidOperationException("The backup does not contain any games installed in this guide.");
            if(imported.PackageIds.Contains(game!.Id)){await LoadGameAsync(game);await ApplyAppearance();}
            await Save();
            backupMessage=$"Imported {string.Join(", ",imported.VersionNames)}.";
        }
        catch(Exception ex) when(ex is System.Text.Json.JsonException or IOException or InvalidOperationException)
        {
            backupError=true;backupMessage=ex.Message;
        }
    }
    ImportedBackup ImportV0(SaveBackup backup)
    {
        var staged=new List<(GameDefinition Definition,GameSaveBackup Backup,Dictionary<string,VersionProgress> Profiles)>();
        foreach(var (gameId,savedGame) in backup.Games??[])
        {
            var definition=catalog!.Games.FirstOrDefault(x=>x.Id==gameId);if(definition is null||savedGame is null)continue;
            var profiles=new Dictionary<string,VersionProgress>();
            foreach(var version in definition.Versions)if(savedGame.Profiles?.TryGetValue(version.Id,out var profile)==true&&profile is not null)
            {
                if(savedGame.ProfileVersions?.TryGetValue(version.Id,out var storedVersion)!=true)throw new InvalidOperationException($"The {version.Name} profile is missing its data version.");
                profiles[version.Id]=MigrateProfile(definition.Id,version.Id,storedVersion,version.ProgressVersion,profile);
            }
            if(profiles.Count==0)throw new InvalidOperationException($"The {definition.ShortName} backup does not contain a recognized game-version profile.");
            staged.Add((definition,savedGame,profiles));
        }
        var importedPackages=new HashSet<string>();var importedVersions=new List<string>();progress.Profiles??=[];progress.ProfileVersions??=[];progress.SelectedVersions??=[];progress.SelectedDexModes??=[];
        foreach(var (definition,savedGame,profiles) in staged)
        {
            var gameId=definition.Id;
            foreach(var (versionId,profile) in profiles){var key=ProfileKeyFor(gameId,versionId);progress.Profiles[key]=profile;progress.ProfileVersions[key]=definition.Versions.First(version=>version.Id==versionId).ProgressVersion;}
            if(profiles.ContainsKey(savedGame.SelectedVersion))progress.SelectedVersions[gameId]=savedGame.SelectedVersion;
            if(definition.DexModes.Any(x=>x.Id==savedGame.SelectedDexMode))progress.SelectedDexModes[gameId]=savedGame.SelectedDexMode;
            importedPackages.Add(gameId);
            importedVersions.AddRange(definition.Versions.Where(version=>profiles.ContainsKey(version.Id)).Select(version=>version.Name));
        }
        return new(importedPackages,importedVersions);
    }
    static VersionProgress CloneProfile(VersionProgress source)=>new(){Caught=[..source.Caught??[]],Collected=[..source.Collected??[]],CompletedSpecial=[..source.CompletedSpecial??[]]};
    static VersionProgress MigrateProfile(string gameId,string versionId,int storedVersion,int targetVersion,VersionProgress source)
    {
        if(storedVersion>targetVersion)throw new InvalidOperationException($"The {versionId} save data is v{storedVersion}, but this guide supports through v{targetVersion}.");
        var migrated=CloneProfile(source);
        while(storedVersion<targetVersion)
        {
            migrated=(gameId,storedVersion) switch
            {
                _=>throw new InvalidOperationException($"No migration exists for {versionId} save data from v{storedVersion} to v{storedVersion+1}.")
            };
            storedVersion++;
        }
        return migrated;
    }
    int AreaPercent(GuideArea area){var checklist=gamePackage!.AreaChecklist(area,progress.Version);var total=checklist.SpeciesIds.Count+checklist.ItemIds.Count;return total==0?0:(int)Math.Round(100d*(checklist.SpeciesIds.Count(CurrentProgress.Caught.Contains)+checklist.ItemIds.Count(CurrentProgress.Collected.Contains))/total);}
    static string LevelText(IEnumerable<Encounter> e){var min=e.Min(x=>x.MinLevel);var max=e.Max(x=>x.MaxLevel);return min==max?$"Lv. {min}":$"Lv. {min}–{max}";}
    static string ChanceText(IEnumerable<Encounter> e)=>$"{e.Sum(x=>x.Chance).ToString("0.0",System.Globalization.CultureInfo.InvariantCulture)}%";
    async Task Reset(){progress.FormatVersion=SavedProgress.CurrentFormatVersion;progress.Profiles=[];progress.ProfileVersions=[];confirmReset=false;await Save();}
    async Task ApplyAppearance(){progress.Accent=ActiveVersion.Accent;await JS.InvokeVoidAsync("fieldGuide.applyAppearance",progress.Theme,game!.Id,progress.Version,ActiveVersion.Accent,ActiveVersion.AccentSoft);}
    static string ProfileKeyFor(string gameId,string version)=>$"{gameId}:{version}";
    static SavedProgress NewProgress()=>new(){FormatVersion=SavedProgress.CurrentFormatVersion};
    sealed record ExportProfileChoice(string ProfileKey,string PackageName,string VersionName);
    sealed record ImportedBackup(HashSet<string> PackageIds,List<string> VersionNames);
    string PokemonIcon(string id)=>gamePackage!.PokemonIcon(id);
    string ItemIcon(GuideItem item)=>gamePackage!.ItemIcon(item);
