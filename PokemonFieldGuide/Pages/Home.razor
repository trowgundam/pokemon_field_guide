@page "/"
@inject IJSRuntime JS
@inject GamePackageLoader PackageLoader
@inject LocalGuideStateModule StateModule

<PageTitle>@(game?.PageTitle ?? "Pokémon Field Guide")</PageTitle>

<header class="topbar">
    <div class="brand"><span class="brand-ball">●</span><div><strong>POKEMON FIELD GUIDE</strong><small>@(game is null ? "INTERACTIVE MAP ATLAS" : $"Pokémon {ActiveVersion.Name}")</small></div></div>
    <div class="top-actions">
        <button class="header-icon desktop-dex" aria-label="Open Pokédex" @onclick="OpenPokedex"><span aria-hidden="true">▦</span></button>
        <button class="header-menu-button" aria-label="Open menu" aria-expanded="@menuOpen" @onclick="()=>menuOpen=!menuOpen"><span aria-hidden="true">☰</span><span>Menu</span></button>
        @if(menuOpen)
        {
            <button class="menu-scrim" aria-label="Close menu" @onclick="()=>menuOpen=false"></button>
            <section class="header-menu" aria-label="Application menu">
                <button class="menu-row mobile-dex" @onclick="OpenPokedex"><span>▦</span> Pokédex</button>
                <label>GAME<select value="@(game is null?null:$"{game.Id}|{State.ActiveVersionId}")" @onchange="ChangePlayableGame">@foreach(var package in catalog?.Games??[]){@foreach(var version in package.Versions){<option value="@($"{package.Id}|{version.Id}")">Pokémon @version.Name</option>}}</select></label>
                <button class="menu-row" @onclick="ToggleTheme"><span>@(State.Theme=="Dark"?"☀":"◐")</span> @(State.Theme=="Dark"?"Use light mode":"Use dark mode")</button>
                <button class="menu-row" @onclick="ToggleAnimations"><span>@(State.AnimationsEnabled?"⏸":"▶")</span> @(State.AnimationsEnabled?"Disable sprite animations":"Enable sprite animations")</button>
                <div class="menu-separator"></div>
                <button class="menu-row" @onclick="OpenExport"><span>⇩</span> Export save data</button>
                <button class="menu-row" @onclick="OpenImport"><span>⇧</span> Import save data</button>
                <div class="menu-separator"></div>
                <button class="menu-row danger-row" @onclick="OpenReset"><span>!</span> Reset progress</button>
            </section>
        }
    </div>
</header>

@if (gamePackage is null && loadError is null) { <main class="loading-card">Rendering the map…</main> }
else if (gamePackage is null)
{
    <main class="loading-card load-error" role="alert">
        <strong>The field guide could not be loaded.</strong>
        <span>@loadError</span>
        @if(recovery is not null)
        {
            <span>Download the stored text before deleting it if you want to inspect or repair it later.</span>
            <div><button @onclick="DownloadRecovery">Download recovery copy</button><button class="danger" @onclick="DeleteLocalData">Delete local data</button></div>
        }
        else { <button @onclick="RetryLoad">Try again</button> }
    </main>
}
else
{
    <main class="atlas-shell">
        <aside class="atlas-sidebar">
            <div class="atlas-heading"><span class="eyebrow">WORLD MAP</span><h1>@game?.AtlasTitle</h1></div>
            <div class="search"><span>⌕</span><input aria-label="Search locations and their contents" placeholder="Search locations, Pokémon, items…" value="@query" @oninput="SearchChanged" @onfocus="()=>searchOpen=true" /></div>
            @if(game?.Regions.Count > 1){<div class="map-filters">@foreach(var choice in game.Regions){<button class="@(currentRegion?.Id==choice.Id?"active":"")" @onclick="()=>ShowRegion(choice)">@choice.Name</button>}</div>}
            <nav class="outdoor-list @(!searchOpen?"closed":"")">
                @foreach (var area in OutdoorAreas)
                {
                    <button class="outdoor-row @(area==mapArea?"active":"")" @onclick="()=>SelectSearchArea(area)"><span><strong>@area.Name</strong><small>@ItemsFor(area).Count items@(area.Resources.Count>0?$" · {area.Resources.Count} resources":"") · @(IsOutdoor(area.Id)?$"{RelevantEntrancesFor(area).Count()} entrances":"interior map")</small></span><b>@AreaPercent(area)%</b></button>
                }
            </nav>
            <div class="legend"><span><i class="legend-pin item-pin">◆</i> Item</span><span><i class="legend-pin hidden-pin">?</i> Hidden</span><span><i class="legend-pin resource-pin">●</i> Resource</span><span><i class="legend-pin door-pin">⌂</i> Entrance</span><span><i class="legend-pin transport-pin">⇄</i> Transport</span></div>
        </aside>

        <section class="map-stage">
            <div class="map-toolbar @(detailArea is not null?"panel-open":"")">
                <div><span class="eyebrow">CONNECTED WORLD / EXPLORE</span><h2>@CurrentWorldName</h2></div>
                <div class="zoom-controls"><button aria-label="Zoom out" @onclick="()=>Zoom(.8)">−</button><button aria-label="Fit world map" @onclick="ResetView">⌖</button><button aria-label="Zoom in" @onclick="()=>Zoom(1.25)">+</button></div>
            </div>
            @if (currentWorld is not null)
            {
                <div class="map-viewport" @ref="mapViewport">
                    <div class="map-world" style="width:@(currentWorld.Width)px;height:@(currentWorld.Height)px">
                        <img src="@currentWorld.Image" alt="@CurrentWorldName connected game world" draggable="false" />
                        @foreach (var placement in currentWorld.Maps)
                        {
                            var area = AreaFor(placement.Id);
                            if (area is not null)
                            {
                                <button class="area-hotspot @(area==mapArea?"selected":"")" aria-label="@area.Name" style="left:@(placement.X)px;top:@(placement.Y)px;width:@(placement.Width)px;height:@(placement.Height)px" @onclick="()=>SelectArea(area)"></button>
                                @foreach (var item in ItemsFor(area).Where(item => item.X >= 0 && item.Y >= 0))
                                {
                                    <button aria-label="@item.Name — @item.Kind item" style="left:@(placement.X+(item.X-placement.MarkerOffsetX)*16+8)px;top:@(placement.Y+(item.Y-placement.MarkerOffsetY)*16+8)px" class="map-marker @(item.Kind=="Hidden"?"hidden-marker":"item-marker") @(CurrentProgress.IsCollected(item.Id)?"done":"")" @onclick="()=>InspectItem(area,item)"><span>@(item.Kind=="Hidden"?"?":"◆")</span><label>@area.Name · @item.Name</label></button>
                                }
                                @foreach (var resource in area.Resources)
                                {
                                    <button aria-label="@resource.Name — @resource.Kind" style="left:@(placement.X+(resource.X-placement.MarkerOffsetX)*16+8)px;top:@(placement.Y+(resource.Y-placement.MarkerOffsetY)*16+8)px" class="map-marker resource-marker" @onclick="()=>InspectResource(area,resource)"><span>●</span><label>@area.Name · @resource.Name · @resource.Kind</label></button>
                                }
                                @foreach (var entrance in RelevantEntrancesFor(area))
                                {
                                    <button aria-label="Enter @entrance.Name" style="left:@(placement.X+(entrance.X-placement.MarkerOffsetX)*16+8)px;top:@(placement.Y+(entrance.Y-placement.MarkerOffsetY)*16+8)px" class="map-marker entrance-marker" @onclick="()=>OpenEntrance(entrance.TargetId)"><span>⌂</span><label>@area.Name · @entrance.Name</label></button>
                                }
                                @foreach (var transport in TransportsFor(area))
                                {
                                    <button aria-label="Travel from @transport.Name" style="left:@(placement.X+(transport.X-placement.MarkerOffsetX)*16+8)px;top:@(placement.Y+(transport.Y-placement.MarkerOffsetY)*16+8)px" class="map-marker transport-marker" @onclick="()=>OpenTransport(transport)"><span>⇄</span><label>@area.Name · @transport.Name</label></button>
                                }
                            }
                        }
                    </div>
                </div>
            }
            <div class="map-hint">Drag to pan · Scroll or use +/− to zoom · Click a marker for details</div>

            <aside class="detail-drawer @(detailArea is null?"closed":"")">
                @if (detailArea is not null)
                {
                    <div class="drawer-handle"></div><button class="drawer-close" aria-label="Close map details" @onclick="()=>detailArea=null">×</button>
                    <span class="eyebrow">@(detailArea==mapArea?"MAP DETAILS":"INSIDE LOCATION")</span><h2>@detailArea.Name</h2>
                    @if (inspectedItem is not null)
                    {
                        <div class="focused-find"><span class="item-gem">◆</span><div><strong>@inspectedItem.Name</strong><small>@inspectedItem.Kind item · X @inspectedItem.X, Y @inspectedItem.Y</small></div><label><input type="checkbox" checked="@CurrentProgress.IsCollected(inspectedItem.Id)" @onchange="()=>ToggleItem(inspectedItem.Id)" /> Collected</label></div>
                    }
                    @if (inspectedResource is not null)
                    {
                        <ResourceDetails Resource="@inspectedResource" ShowCoordinates="true" />
                    }
                    @if (EncounterGroups.Any())
                    {
                        @foreach(var encounterGroup in EncounterGroups)
                        {
                            <h3>@encounterGroup.Name <small>@encounterGroup.Encounters.Select(x=>x.SpeciesId).Distinct().Count() species</small></h3>
                            <div class="drawer-grid">@foreach(var mon in encounterGroup.Encounters.GroupBy(x=>x.SpeciesId).OrderBy(x=>x.First().Species)){var first=mon.First();<button class="mini-find @(CurrentProgress.IsCaught(mon.Key)?"done":"")" @onclick="()=>ToggleCaught(mon.Key)"><i>✓</i><img alt="" src="@PokemonIcon(first.SpeciesId)" onerror="@PokemonFallbackScript"/><span><strong>@first.Species</strong><small>@string.Join(" · ",mon.Select(x=>x.Method).Distinct()) · @LevelText(mon) · @ChanceText(mon)</small></span></button>}</div>
                        }
                    }
                    @if (SpecialPokemonGroups.Any())
                    {
                        @foreach(var group in SpecialPokemonGroups) { <h3>@(group.Kind=="Trade"?"In-game trades":group.Kind+" Pokémon")</h3><div class="drawer-grid">@foreach(var mon in group.Pokemon.OrderBy(x=>x.Species)){<button class="mini-find @(CurrentProgress.IsSpecialCompleted(mon.Id)?"done":"")" @onclick="()=>ToggleSpecial(mon)"><i>★</i><img alt="" src="@PokemonIcon(mon.SpeciesId)" onerror="@PokemonFallbackScript"/><span><strong>@mon.Species</strong><small>@(mon.Kind=="Trade"?$"For {mon.RequestedSpecies}":$"Lv. {mon.Level}")</small></span></button>}</div> }
                    }
                    @if (ItemsFor(detailArea).Count > 0)
                    {
                        @foreach(var group in ItemGroupsFor(detailArea)){<h3>@group.Kind items <small>@group.Items.Count</small></h3><div class="drawer-items">@foreach(var item in group.Items.OrderBy(x=>x.Name)){<label class="@(CurrentProgress.IsCollected(item.Id)?"done":"")"><input type="checkbox" checked="@CurrentProgress.IsCollected(item.Id)" @onchange="()=>ToggleItem(item.Id)"/><img alt="" src="@ItemIcon(item)" onerror="@ItemFallbackScript"/><span><strong>@item.Name</strong><small>@(item.X<0?"Received from an event":$"X {item.X}, Y {item.Y}")</small></span></label>}</div>}
                    }
                    @if (detailArea.Resources.Any())
                    {
                        <h3>Renewable resources <small>@detailArea.Resources.Count</small></h3><div class="resource-list">@foreach(var resource in detailArea.Resources.OrderBy(x=>x.Name)){<button @onclick="()=>InspectResource(detailArea,resource)"><i>●</i><span><strong>@resource.Name</strong><small>@resource.Kind · X @resource.X, Y @resource.Y</small></span></button>}</div>
                    }
                }
            </aside>
        </section>
    </main>
}

@if(!string.IsNullOrEmpty(stateError)){<div class="state-error" role="alert"><span>@stateError</span><button aria-label="Dismiss error" @onclick="DismissStateError">×</button></div>}

@if(interiorOpen && interiorArea is not null)
{
    <div class="interior-backdrop">
        <section class="interior-modal" role="dialog" aria-modal="true" aria-labelledby="interior-title">
            <header><div><span class="eyebrow">INTERIOR MAP</span><h2 id="interior-title">@InteriorTitle</h2></div>@if(InteriorFloors.Count>1){<select aria-label="Interior floor" @onchange="ChangeInterior">@foreach(var floor in InteriorFloors){<option value="@floor.Id" selected="@(floor==interiorArea)">@floor.Name</option>}</select>}<button aria-label="Close interior map" @onclick="()=>interiorOpen=false">×</button></header>
            <div class="interior-body">
                <div class="interior-map"><div class="interior-map-controls"><button aria-label="Zoom interior out" @onclick="()=>ZoomInterior(.8)">−</button><button aria-label="Fit interior map" @onclick="FitInterior">⌖</button><button aria-label="Zoom interior in" @onclick="()=>ZoomInterior(1.25)">+</button></div>@if(InteriorMap is not null){<div class="interior-canvas" style="width:@(InteriorMap.Width)px;height:@(InteriorMap.Height)px"><img alt="@InteriorTitle map" src="@InteriorMap.Image" draggable="false"/>@foreach(var item in ItemsFor(interiorArea).Where(x=>x.X>=0)){<button aria-label="@item.Name" class="map-marker @(item.Kind=="Hidden"?"hidden-marker":"item-marker") @(CurrentProgress.IsCollected(item.Id)?"done":"")" style="left:@(item.X*16+8)px;top:@(item.Y*16+8)px" @onclick="()=>InspectInteriorItem(item)"><span>@(item.Kind=="Hidden"?"?":"◆")</span><label>@item.Name@(item.Quantity>1?$" ×{item.Quantity}":"")</label></button>}@foreach(var resource in interiorArea.Resources){<button aria-label="@resource.Name — @resource.Kind" class="map-marker resource-marker" style="left:@(resource.X*16+8)px;top:@(resource.Y*16+8)px" @onclick="()=>InspectInteriorResource(resource)"><span>●</span><label>@resource.Name · @resource.Kind</label></button>}@foreach(var warp in RelevantEntrancesFor(interiorArea).Where(x=>InteriorFloors.Any(f=>f.Id==x.TargetId))){<button aria-label="Go to @warp.Name" class="map-marker entrance-marker" style="left:@(warp.X*16+8)px;top:@(warp.Y*16+8)px" @onclick="()=>NavigateInterior(warp.TargetId)"><span>⌂</span><label>@warp.Name</label></button>}@foreach(var transport in TransportsFor(interiorArea)){<button aria-label="Travel from @transport.Name" class="map-marker transport-marker" style="left:@(transport.X*16+8)px;top:@(transport.Y*16+8)px" @onclick="()=>OpenTransport(transport)"><span>⇄</span><label>@transport.Name</label></button>}</div>}</div>
                <div class="interior-guide">
                    @if(inspectedItem is not null){<div class="focused-find"><img alt="" src="@ItemIcon(inspectedItem)" onerror="@ItemFallbackScript"/><div><strong>@inspectedItem.Name</strong><small>@inspectedItem.Kind item</small></div><label><input type="checkbox" checked="@CurrentProgress.IsCollected(inspectedItem.Id)" @onchange="()=>ToggleItem(inspectedItem.Id)"/> Collected</label></div>}
                    @if(inspectedResource is not null){<ResourceDetails Resource="@inspectedResource" />}
                    @foreach(var encounterGroup in EncounterGroupsFor(interiorArea)){<h3>@encounterGroup.Name</h3><div class="drawer-grid">@foreach(var mon in encounterGroup.Encounters.GroupBy(x=>x.SpeciesId).OrderBy(x=>x.First().Species)){var first=mon.First();<button class="mini-find @(CurrentProgress.IsCaught(mon.Key)?"done":"")" @onclick="()=>ToggleCaught(mon.Key)"><i>✓</i><img alt="" src="@PokemonIcon(first.SpeciesId)" onerror="@PokemonFallbackScript"/><span><strong>@first.Species</strong><small>@LevelText(mon) · @ChanceText(mon)</small></span></button>}</div>}
                    @foreach(var group in SpecialPokemonGroupsFor(interiorArea)){<h3>@(group.Kind=="Trade"?"In-game trades":group.Kind+" Pokémon")</h3><div class="drawer-grid">@foreach(var mon in group.Pokemon.OrderBy(x=>x.Species)){<button class="mini-find @(CurrentProgress.IsSpecialCompleted(mon.Id)?"done":"")" @onclick="()=>ToggleSpecial(mon)"><i>★</i><img alt="" src="@PokemonIcon(mon.SpeciesId)" onerror="@PokemonFallbackScript"/><span><strong>@mon.Species</strong><small>@(mon.Kind=="Trade"?$"For {mon.RequestedSpecies}":$"Lv. {mon.Level}")</small></span></button>}</div>}
                    @foreach(var group in ItemGroupsFor(interiorArea)){<h3>@group.Kind items</h3>@foreach(var item in group.Items.OrderBy(x=>x.Name)){<label class="interior-check @(CurrentProgress.IsCollected(item.Id)?"done":"")"><input type="checkbox" checked="@CurrentProgress.IsCollected(item.Id)" @onchange="()=>ToggleItem(item.Id)"/><img alt="" src="@ItemIcon(item)" onerror="@ItemFallbackScript"/><span>@item.Name</span></label>}}
                    @if(interiorArea.Resources.Any()){<h3>Renewable resources</h3><div class="resource-list">@foreach(var resource in interiorArea.Resources.OrderBy(x=>x.Name)){<button @onclick="()=>InspectInteriorResource(resource)"><i>●</i><span><strong>@resource.Name</strong><small>@resource.Kind</small></span></button>}</div>}
                </div>
            </div>
        </section>
    </div>
}

@if(selectedTransport is not null)
{
    <div class="modal-backdrop transport-backdrop" @onclick="CloseTransport">
        <section class="transport-modal" role="dialog" aria-modal="true" aria-labelledby="transport-title" @onclick:stopPropagation>
            <header><div><span class="eyebrow">TRANSPORT</span><h2 id="transport-title">@selectedTransport.Name</h2></div><button aria-label="Close transport destinations" @onclick="CloseTransport">×</button></header>
            <p>Choose a destination. Requirements are shown for reference and do not lock navigation.</p>
            <div class="transport-destinations">
                @foreach(var destination in selectedTransport.Destinations)
                {
                    <button @onclick="()=>TravelTo(destination)"><span><strong>@destination.Name</strong>@if(destination.Requirement is not null){<small>Requires @destination.Requirement</small>}</span><b>Travel →</b></button>
                }
            </div>
        </section>
    </div>
}

@if(pokedexOpen)
{
    <div class="pokedex-backdrop" @onclick="()=>pokedexOpen=false"><section class="pokedex-modal" role="dialog" aria-modal="true" aria-labelledby="pokedex-title" @onclick:stopPropagation><header><div><span class="eyebrow">@(State.ActiveDexModeId.ToUpperInvariant()) POKÉDEX</span><h2 id="pokedex-title">@DexCaughtCount / @VisiblePokedex.Count caught</h2></div><div class="dex-mode" aria-label="Pokédex type">@foreach(var mode in game!.DexModes){<button class="@(State.ActiveDexModeId==mode.Id?"active":"")" @onclick="()=>ChangeDexMode(mode.Id)">@mode.Name</button>}</div><input aria-label="Search Pokédex" placeholder="Search name or number…" @bind="pokedexQuery" @bind:event="oninput"/><button class="dex-close" aria-label="Close Pokédex" @onclick="()=>pokedexOpen=false">×</button></header><div class="pokedex-grid">@foreach(var result in FilteredPokedex){var mon=result.Entry;var caught=CurrentProgress.IsCaught(mon.SpeciesId);<button class="dex-entry @(caught?"caught":"") @(result.Availability=="Obtainable"?"":"unavailable")" @onclick="()=>ToggleCaught(mon.SpeciesId)"><span class="dex-number">#@result.Number.ToString("D3")</span><img alt="" src="@PokemonIcon(mon.SpeciesId)" onerror="@PokemonFallbackScript"/><span><strong>@mon.Name</strong><small>@(caught?"Caught":result.Availability)</small></span><i>✓</i></button>}</div></section></div>
}

@if(backupOpen)
{
    <div class="modal-backdrop" @onclick="CloseBackup">
        <section class="backup-modal" role="dialog" aria-modal="true" aria-labelledby="backup-title" @onclick:stopPropagation>
            <header><div><span class="eyebrow">CHECKLIST BACKUP</span><h2 id="backup-title">@(backupMode=="export"?"Export backup":"Import backup")</h2></div><button aria-label="Close backup" @onclick="CloseBackup">×</button></header>
            @if(backupMode=="export")
            {
                <p>Choose which games to include. Paired versions keep independent progress while sharing their guide package and assets.</p>
                <div class="backup-games">
                    @foreach(var choice in ExportChoices)
                    {
                        <label><input type="checkbox" checked="@exportProfileIds.Contains(choice.ProfileId)" @onchange="e=>ToggleProfile(exportProfileIds,choice.ProfileId,e)"/><span><strong>@choice.VersionName</strong><small>@choice.PackageName</small></span></label>
                    }
                </div>
                @if(!string.IsNullOrEmpty(backupMessage)){<p class="backup-message success">@backupMessage</p>}
                <footer><button @onclick="CloseBackup">Cancel</button><button class="primary" disabled="@(exportProfileIds.Count==0)" @onclick="ExportBackup">Download backup</button></footer>
            }
            else
            {
                <p>Imported checklist profiles replace matching local progress. Profiles that you do not select and all preferences stay unchanged.</p>
                @if(importPreview is null)
                {
                    <label class="file-picker"><span>Choose backup file</span><InputFile accept="application/json,.json" OnChange="PreviewImport" /></label>
                }
                else
                {
                    <div class="backup-games">
                        @foreach(var choice in importPreview.Profiles)
                        {
                            <label><input type="checkbox" checked="@importProfileIds.Contains(choice.ProfileId)" @onchange="e=>ToggleProfile(importProfileIds,choice.ProfileId,e)"/><span><strong>@choice.VersionName</strong><small>@choice.PackageName · @(choice.Effect==PortableBackupImportEffect.Clear?"Clears local progress":choice.Effect==PortableBackupImportEffect.Replace?"Replaces local progress":"Adds progress")</small></span></label>
                        }
                    </div>
                }
                @if(!string.IsNullOrEmpty(backupMessage)){<p class="backup-message @(backupError?"error":"success")">@backupMessage</p>}
                <footer><button @onclick="CloseBackup">Cancel</button>@if(importPreview is not null){<button class="primary" disabled="@(importProfileIds.Count==0)" @onclick="ImportBackup">Import selected</button>}</footer>
            }
        </section>
    </div>
}

@if(confirmReset){<div class="modal-backdrop" @onclick="()=>confirmReset=false"><div class="modal" role="dialog" aria-modal="true" aria-labelledby="reset-title" @onclick:stopPropagation><span class="warning">!</span><h2 id="reset-title">Reset checklist progress?</h2><p>Select the games to clear. Preferences remain unchanged.</p><div class="backup-games">@foreach(var choice in localState!.ResetChoices){<label><input type="checkbox" checked="@resetProfileIds.Contains(choice.ProfileId)" @onchange="e=>ToggleProfile(resetProfileIds,choice.ProfileId,e)"/><span><strong>@choice.VersionName</strong><small>@choice.PackageName</small></span></label>}</div><div><button @onclick="()=>confirmReset=false">Cancel</button><button class="danger" disabled="@(resetProfileIds.Count==0)" @onclick="Reset">Reset selected</button></div></div></div>}

@code {
    GameCatalog? catalog; GamePackage? gamePackage; GameDefinition? game; GuideWorld? currentWorld; GameRegionDefinition? currentRegion; GuideArea? mapArea; GuideArea? detailArea; GuideArea? interiorArea; GuideItem? inspectedItem; GuideMapResource? inspectedResource; DisplayTransport? selectedTransport; LocalGuideSession? localState; LocalGuideRecovery? recovery; PortableBackupPreview? importPreview; string query="",pokedexQuery="",backupMode="export",backupMessage="",stateError=""; bool confirmReset,searchOpen,interiorOpen,pokedexOpen,menuOpen,backupOpen,backupError; HashSet<ChecklistProfileId> exportProfileIds=[],importProfileIds=[],resetProfileIds=[]; ElementReference mapViewport; string? initializedMap,initializedInterior,loadError;
    LocalGuideSnapshot State=>localState?.Current??LocalGuideSnapshot.Empty;
    ChecklistProfileView CurrentProgress=>State.Checklist;
    GameVersionDefinition ActiveVersion=>game!.Versions.First(version=>version.Id==State.ActiveVersionId);
    string PokemonFallback=>gamePackage!.PokemonFallback;
    string ItemFallback=>gamePackage!.ItemFallback;
    string PokemonFallbackScript=>$"this.src='{PokemonFallback}'";
    string ItemFallbackScript=>$"this.src='{ItemFallback}'";
    IReadOnlyList<PokedexResult> VisiblePokedex=>gamePackage!.SearchPokedex(State.ActiveDexModeId,State.ActiveVersionId,"");
    IReadOnlyList<PokedexResult> FilteredPokedex=>gamePackage!.SearchPokedex(State.ActiveDexModeId,State.ActiveVersionId,pokedexQuery);
    int DexCaughtCount=>VisiblePokedex.Count(result=>CurrentProgress.IsCaught(result.Entry.SpeciesId));
    IReadOnlyList<GuideArea> OutdoorAreas=>string.IsNullOrWhiteSpace(query)?gamePackage!.AreasForWorld(currentWorld!.Id):gamePackage!.SearchAreas(query,State.ActiveVersionId);
    IReadOnlyList<EncounterGroup> EncounterGroups=>detailArea is null?[]:gamePackage!.EncounterGroups(detailArea,State.ActiveVersionId);
    IReadOnlyList<SpecialPokemonGroup> SpecialPokemonGroups=>detailArea is null?[]:gamePackage!.SpecialPokemonGroups(detailArea,State.ActiveVersionId);
    IReadOnlyList<GuideArea> InteriorFloors=>interiorArea is null?[]:gamePackage!.InteriorFloors(interiorArea.Id);
    AreaMapDescriptor? InteriorMap=>interiorArea is null?null:gamePackage!.AreaMap(interiorArea,State.ActiveVersionId);
    string CurrentWorldName=>currentWorld is null?"":gamePackage!.WorldName(currentWorld);
    string InteriorTitle=>interiorArea!.Name;
    protected override Task OnInitializedAsync()=>InitializeAsync();
    async Task InitializeAsync()
    {
        loadError=null;recovery=null;gamePackage=null;
        try
        {
            catalog=await PackageLoader.LoadCatalogAsync();
            var opened=await StateModule.OpenAsync(catalog);
            if(opened is LocalGuideOpenResult.RecoveryRequired needsRecovery){recovery=needsRecovery.Recovery;loadError=needsRecovery.Recovery.Message;return;}
            if(opened is LocalGuideOpenResult.StorageFailed storageFailure){loadError=storageFailure.Message;return;}
            localState=((LocalGuideOpenResult.Ready)opened).Session;
            game=catalog.Games.First(choice=>choice.Id==State.ActivePackageId);
            await LoadGameAsync(game);
        }
        catch(Exception ex)
        {
            gamePackage=null;
            loadError=PackageLoadError(ex);
        }
    }
    Task RetryLoad()=>InitializeAsync();
    protected override async Task OnAfterRenderAsync(bool first){if(game is not null){await ApplyAppearance();await JS.InvokeVoidAsync("fieldGuide.applySpriteAnimations",State.AnimationsEnabled);}if(currentWorld?.Id!=initializedMap){initializedMap=currentWorld?.Id;await JS.InvokeVoidAsync("fieldMap.init",mapViewport);}var interiorKey=interiorOpen&&InteriorMap is not null?$"{State.ActiveVersionId}|{interiorArea?.Id}|{InteriorMap.Image}|{InteriorMap.Width}x{InteriorMap.Height}":null;if(interiorKey is not null&&interiorKey!=initializedInterior){initializedInterior=interiorKey;await JS.InvokeVoidAsync("fieldMap.initInterior");}if(!interiorOpen)initializedInterior=null;}
    async Task LoadGameAsync(GameDefinition definition)=>UseGamePackage(await PackageLoader.LoadAsync(definition));
    void UseGamePackage(GamePackage loadedPackage){gamePackage=loadedPackage;game=gamePackage.Definition;currentWorld=gamePackage.DefaultWorld;currentRegion=game.Regions.FirstOrDefault(region=>region.WorldId==currentWorld.Id);mapArea=gamePackage.DefaultArea;detailArea=mapArea;interiorArea=null;interiorOpen=false;selectedTransport=null;initializedMap=null;}
    GuideArea? AreaFor(string id)=>gamePackage!.Area(id);
    IReadOnlyList<EncounterGroup> EncounterGroupsFor(GuideArea area)=>gamePackage!.EncounterGroups(area,State.ActiveVersionId);
    IReadOnlyList<GuideItem> ItemsFor(GuideArea area)=>gamePackage!.ItemsFor(area,State.ActiveVersionId);
    IReadOnlyList<ItemGroup> ItemGroupsFor(GuideArea area)=>gamePackage!.ItemGroups(area, State.ActiveVersionId);
    IReadOnlyList<SpecialPokemonGroup> SpecialPokemonGroupsFor(GuideArea area)=>gamePackage!.SpecialPokemonGroups(area,State.ActiveVersionId);
    IReadOnlyList<DisplayEntrance> RelevantEntrancesFor(GuideArea area)=>gamePackage!.RelevantEntrances(area);
    IReadOnlyList<DisplayTransport> TransportsFor(GuideArea area)=>gamePackage!.TransportsFor(area,State.ActiveVersionId);
    bool IsOutdoor(string id)=>gamePackage!.IsOutdoor(id);
    void SearchChanged(ChangeEventArgs e){query=e.Value?.ToString()??"";searchOpen=true;}
    void SelectArea(GuideArea area){mapArea=area;detailArea=area;inspectedItem=null;inspectedResource=null;searchOpen=false;query="";}
    void SelectSearchArea(GuideArea area){if(IsOutdoor(area.Id)){var world=gamePackage!.WorldForArea(area.Id);if(world is not null&&world!=currentWorld){currentWorld=world;currentRegion=game!.Regions.FirstOrDefault(region=>region.WorldId==world.Id);initializedMap=null;}SelectArea(area);}else{OpenEntrance(area.Id);searchOpen=false;query="";}}
    void ShowRegion(GameRegionDefinition selected){currentRegion=selected;currentWorld=gamePackage!.World(selected.WorldId);initializedMap=null;}
    void OpenEntrance(string targetId){interiorArea=gamePackage!.Area(targetId);if(interiorArea is not null){interiorOpen=true;inspectedItem=null;inspectedResource=null;}}
    void OpenTransport(DisplayTransport transport)=>selectedTransport=transport;
    void CloseTransport()=>selectedTransport=null;
    void TravelTo(DisplayTransportDestination destination)
    {
        selectedTransport=null;
        var target=gamePackage!.Area(destination.TargetId);
        if(target is null)return;
        var world=gamePackage.WorldForArea(target.Id);
        if(world is null){OpenEntrance(target.Id);return;}
        interiorOpen=false;interiorArea=null;currentWorld=world;currentRegion=game!.Regions.FirstOrDefault(region=>region.WorldId==world.Id);initializedMap=null;SelectArea(target);
    }
    void InspectItem(GuideArea area,GuideItem item){mapArea=area;detailArea=area;inspectedItem=item;inspectedResource=null;}
    void InspectResource(GuideArea area,GuideMapResource resource){mapArea=area;detailArea=area;inspectedItem=null;inspectedResource=resource;}
    void InspectInteriorItem(GuideItem item){inspectedItem=item;inspectedResource=null;}
    void InspectInteriorResource(GuideMapResource resource){inspectedItem=null;inspectedResource=resource;}
    void NavigateInterior(string targetId){interiorArea=gamePackage!.Area(targetId)??interiorArea;inspectedItem=null;inspectedResource=null;} void ChangeInterior(ChangeEventArgs e){interiorArea=gamePackage!.Area((string?)e.Value??"")??interiorArea;inspectedItem=null;inspectedResource=null;}
    async Task Zoom(double z)=>await JS.InvokeVoidAsync("fieldMap.zoom",mapViewport,z); async Task ResetView()=>await JS.InvokeVoidAsync("fieldMap.reset",mapViewport);
    async Task ZoomInterior(double z)=>await JS.InvokeVoidAsync("fieldMap.zoomInterior",z); async Task FitInterior()=>await JS.InvokeVoidAsync("fieldMap.fitInterior");
    async Task<bool> Apply(Task<LocalGuideChangeResult> pending)
    {
        var result=await pending;
        if(result is LocalGuideChangeResult.Applied){stateError="";return true;}
        stateError=result switch{LocalGuideChangeResult.Rejected rejected=>rejected.Message,LocalGuideChangeResult.StorageFailed failed=>failed.Message,_=>"The local guide state could not be changed."};
        return false;
    }
    void DismissStateError()=>stateError="";
    async Task ToggleItem(string id)=>await Apply(localState!.ToggleCollectedAsync(id));
    async Task ToggleCaught(string id)=>await Apply(localState!.ToggleCaughtAsync(id));
    async Task ToggleSpecial(SpecialPokemon mon)=>await Apply(localState!.ToggleSpecialAsync(mon.Id,mon.SpeciesId));
    async Task ChangePlayableGame(ChangeEventArgs e)
    {
        var parts=((string?)e.Value)?.Split('|',2);if(parts?.Length!=2)return;
        var definition=catalog!.Games.FirstOrDefault(choice=>choice.Id==parts[0]);if(definition is null||!definition.Versions.Any(version=>version.Id==parts[1]))return;
        GamePackage? loadedPackage=null;
        if(game?.Id!=definition.Id)
        {
            try{loadedPackage=await PackageLoader.LoadAsync(definition);}
            catch(Exception ex){stateError=PackageLoadError(ex);return;}
        }
        if(!await Apply(localState!.SelectPlayableGameAsync(parts[0],parts[1])))return;
        if(loadedPackage is not null)UseGamePackage(loadedPackage);
        else{inspectedItem=null;inspectedResource=null;selectedTransport=null;initializedInterior=null;}
        await ApplyAppearance();
    }
    async Task ChangeDexMode(string mode){if(await Apply(localState!.SetDexModeAsync(mode)))pokedexQuery="";}
    async Task ToggleTheme(){if(await Apply(localState!.SetThemeAsync(State.Theme=="Dark"?"Light":"Dark")))await ApplyAppearance();}
    async Task ToggleAnimations(){if(await Apply(localState!.SetAnimationsAsync(!State.AnimationsEnabled)))await JS.InvokeVoidAsync("fieldGuide.applySpriteAnimations",State.AnimationsEnabled);}
    void OpenPokedex(){menuOpen=false;pokedexOpen=true;}
    IEnumerable<ProfileChoice> ExportChoices=>catalog!.Games.SelectMany(package=>package.Versions.Select(version=>new ProfileChoice(new(package.Id,version.Id),package.Name,version.Name)));
    void OpenReset(){menuOpen=false;resetProfileIds=[];var active=new ChecklistProfileId(State.ActivePackageId,State.ActiveVersionId);if(localState!.ResetChoices.Any(choice=>choice.ProfileId==active))resetProfileIds.Add(active);confirmReset=true;}
    void OpenExport(){menuOpen=false;backupMode="export";backupMessage="";backupError=false;exportProfileIds=[..ExportChoices.Select(choice=>choice.ProfileId)];backupOpen=true;}
    void OpenImport(){menuOpen=false;backupMode="import";backupMessage="";backupError=false;importPreview=null;importProfileIds=[];backupOpen=true;}
    void CloseBackup(){backupOpen=false;backupMessage="";importPreview=null;}
    static void ToggleProfile(HashSet<ChecklistProfileId> selected,ChecklistProfileId profileId,ChangeEventArgs e){if(e.Value is true)selected.Add(profileId);else selected.Remove(profileId);}
    async Task ExportBackup()
    {
        var backup=localState!.CreatePortableBackup(exportProfileIds);
        await JS.InvokeVoidAsync("fieldGuide.downloadText",backup.SuggestedFileName,"application/json",backup.Contents);
        backupMessage="Backup downloaded.";
    }
    async Task PreviewImport(InputFileChangeEventArgs e)
    {
        backupMessage="";backupError=false;
        try
        {
            await using var stream=e.File.OpenReadStream(2*1024*1024);
            using var reader=new StreamReader(stream);
            var preview=localState!.PreviewPortableBackup(await reader.ReadToEndAsync());
            if(preview is PortableBackupPreviewResult.Rejected rejected){backupError=true;backupMessage=rejected.Message;return;}
            importPreview=((PortableBackupPreviewResult.Ready)preview).Preview;
            importProfileIds=[..importPreview.Profiles.Select(profile=>profile.ProfileId)];
        }
        catch(Exception ex) when(ex is IOException or InvalidOperationException)
        {
            backupError=true;backupMessage=ex.Message;
        }
    }
    async Task ImportBackup()
    {
        if(importPreview is null)return;
        if(await Apply(localState!.ImportPortableBackupAsync(importPreview,importProfileIds))){backupMessage=$"Imported {importProfileIds.Count} checklist profile{(importProfileIds.Count==1?"":"s")}.";importPreview=null;importProfileIds=[];}
        else{backupError=true;backupMessage=stateError;}
    }
    int AreaPercent(GuideArea area){var checklist=gamePackage!.AreaChecklist(area,State.ActiveVersionId);var total=checklist.SpeciesIds.Count+checklist.ItemIds.Count;return total==0?0:(int)Math.Round(100d*(checklist.SpeciesIds.Count(CurrentProgress.IsCaught)+checklist.ItemIds.Count(CurrentProgress.IsCollected))/total);}
    static string LevelText(IEnumerable<Encounter> e){var min=e.Min(x=>x.MinLevel);var max=e.Max(x=>x.MaxLevel);return min==max?$"Lv. {min}":$"Lv. {min}–{max}";}
    static string ChanceText(IEnumerable<Encounter> e)=>$"{e.Sum(x=>x.Chance).ToString("0.0",System.Globalization.CultureInfo.InvariantCulture)}%";
    async Task Reset(){if(await Apply(localState!.ResetProfilesAsync(resetProfileIds)))confirmReset=false;}
    async Task DownloadRecovery()=>await JS.InvokeVoidAsync("fieldGuide.downloadText",$"pokemon-field-guide-recovery-{DateTime.UtcNow:yyyy-MM-dd}.txt","text/plain",recovery!.RawText);
    async Task DeleteLocalData(){var result=await recovery!.DeleteAndStartFreshAsync();if(result is LocalGuideChangeResult.Applied applied){localState=applied.Session;recovery=null;loadError=null;game=catalog!.Games.First(choice=>choice.Id==State.ActivePackageId);await LoadGameAsync(game);}else stateError=((LocalGuideChangeResult.StorageFailed)result).Message;}
    static string PackageLoadError(Exception ex)=>ex switch{HttpRequestException=>"The game data could not be downloaded. Check your connection and try again.",InvalidOperationException=>ex.Message,_=>"The installed game package is invalid or unavailable. Reload the page or try again shortly."};
    async Task ApplyAppearance()=>await JS.InvokeVoidAsync("fieldGuide.applyAppearance",State.Theme,game!.Id,State.ActiveVersionId,ActiveVersion.Accent,ActiveVersion.AccentSoft);
