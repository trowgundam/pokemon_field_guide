@page "/"
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>FRLG Interactive Field Guide</PageTitle>

<header class="topbar">
    <div class="brand"><span class="brand-ball">●</span><div><strong>FIELD GUIDE</strong><small>INTERACTIVE KANTO ATLAS</small></div></div>
    <div class="top-actions">
        <label class="version-picker">GAME<select value="@progress.Version" @onchange="ChangeVersion"><option>FireRed</option><option>LeafGreen</option></select></label>
        <button class="pokedex-button" @onclick="()=>pokedexOpen=true">Pokédex</button>
        <button class="theme-button" @onclick="ToggleTheme">@(progress.Theme=="Dark"?"☀ Light":"◐ Dark")</button>
        <button class="reset-button" @onclick="() => confirmReset=true">Reset progress</button>
    </div>
</header>

@if (data is null) { <main class="loading-card">Rendering the map…</main> }
else
{
    <main class="atlas-shell">
        <aside class="atlas-sidebar">
            <div class="atlas-heading"><span class="eyebrow">WORLD MAP</span><h1>Kanto & Sevii</h1></div>
            <div class="search"><span>⌕</span><input aria-label="Search locations" placeholder="Search locations…" @bind="query" @bind:event="oninput" @onfocus="()=>searchOpen=true" /></div>
            <div class="map-filters"><button class="@(region=="Kanto"?"active":"")" @onclick="ShowKanto">Kanto</button><button class="@(region=="Sevii Islands"?"active":"")" @onclick="ShowSevii">Sevii</button></div>
            <nav class="outdoor-list @(!searchOpen?"closed":"")">
                @foreach (var area in OutdoorAreas)
                {
                    <button class="outdoor-row @(area==mapArea?"active":"")" @onclick="()=>SelectSearchArea(area)"><span><strong>@area.Name</strong><small>@area.Items.Count items · @(IsOutdoor(area.Id)?$"{RelevantEntrancesFor(area).Count()} entrances":"interior map")</small></span><b>@AreaPercent(area)%</b></button>
                }
            </nav>
            <div class="legend"><span><i class="legend-pin item-pin">◆</i> Item</span><span><i class="legend-pin hidden-pin">?</i> Hidden</span><span><i class="legend-pin door-pin">⌂</i> Entrance</span></div>
        </aside>

        <section class="map-stage">
            <div class="map-toolbar @(detailArea is not null?"panel-open":"")">
                <div><span class="eyebrow">CONNECTED WORLD / EXPLORE</span><h2>@(currentWorld?.Id == "kanto" ? "Kanto" : "Sevii Islands")</h2></div>
                <div class="zoom-controls"><button aria-label="Zoom out" @onclick="()=>Zoom(.8)">−</button><button aria-label="Fit world map" @onclick="ResetView">⌖</button><button aria-label="Zoom in" @onclick="()=>Zoom(1.25)">+</button></div>
            </div>
            @if (currentWorld is not null)
            {
                <div class="map-viewport" @ref="mapViewport">
                    <div class="map-world" style="width:@(currentWorld.Width)px;height:@(currentWorld.Height)px">
                        <img src="@currentWorld.Image" alt="@(currentWorld.Id) connected game world" draggable="false" />
                        @foreach (var placement in currentWorld.Maps)
                        {
                            var area = AreaFor(placement.Id);
                            if (area is not null)
                            {
                                <button class="area-hotspot @(area==mapArea?"selected":"")" aria-label="@area.Name" style="left:@(placement.X)px;top:@(placement.Y)px;width:@(placement.Width)px;height:@(placement.Height)px" @onclick="()=>SelectArea(area)"></button>
                                @foreach (var item in area.Items.Where(item => item.X >= 0 && item.Y >= 0))
                                {
                                    <button aria-label="@item.Name — @item.Kind item" style="left:@(placement.X+item.X*16+8)px;top:@(placement.Y+item.Y*16+8)px" class="map-marker @(item.Kind=="Hidden"?"hidden-marker":"item-marker") @(CurrentProgress.Collected.Contains(item.Id)?"done":"")" @onclick="()=>InspectItem(area,item)"><span>@(item.Kind=="Hidden"?"?":"◆")</span><label>@area.Name · @item.Name</label></button>
                                }
                                @foreach (var entrance in RelevantEntrancesFor(area))
                                {
                                    <button aria-label="Enter @entrance.Name" style="left:@(placement.X+entrance.X*16+8)px;top:@(placement.Y+entrance.Y*16+8)px" class="map-marker entrance-marker" @onclick="()=>OpenEntrance(entrance.TargetId)"><span>⌂</span><label>@area.Name · @entrance.Name</label></button>
                                }
                            }
                        }
                    </div>
                </div>
            }
            <div class="map-hint">Drag to pan · Scroll or use +/− to zoom · Click a marker for details</div>

            <aside class="detail-drawer @(detailArea is null?"closed":"")">
                @if (detailArea is not null)
                {
                    <div class="drawer-handle"></div><button class="drawer-close" aria-label="Close map details" @onclick="()=>detailArea=null">×</button>
                    <span class="eyebrow">@(detailArea==mapArea?"MAP DETAILS":"INSIDE LOCATION")</span><h2>@detailArea.Name</h2>
                    @if (inspectedItem is not null)
                    {
                        <div class="focused-find"><span class="item-gem">◆</span><div><strong>@inspectedItem.Name</strong><small>@inspectedItem.Kind item · X @inspectedItem.X, Y @inspectedItem.Y</small></div><label><input type="checkbox" checked="@CurrentProgress.Collected.Contains(inspectedItem.Id)" @onchange="()=>ToggleItem(inspectedItem.Id)" /> Collected</label></div>
                    }
                    @if (VisibleEncounters.Any())
                    {
                        @foreach(var encounterGroup in EncounterGroups)
                        {
                            <h3>@encounterGroup.Key <small>@encounterGroup.Select(x=>x.SpeciesId).Distinct().Count() species</small></h3>
                            <div class="drawer-grid">@foreach(var mon in encounterGroup.GroupBy(x=>x.SpeciesId).OrderBy(x=>x.First().Species)){var first=mon.First();<button class="mini-find @(CurrentProgress.Caught.Contains(mon.Key)?"done":"")" @onclick="()=>ToggleCaught(mon.Key)"><i>✓</i><img alt="" src="@PokemonIcon(first.SpeciesId)" onerror="this.src='sprites/pokemon/question_mark.png'"/><span><strong>@first.Species</strong><small>@string.Join(" · ",mon.Select(x=>x.Method).Distinct()) · @LevelText(mon)</small></span></button>}</div>
                        }
                    }
                    @if (VisibleSpecial.Any())
                    {
                        @foreach(var group in VisibleSpecial.GroupBy(x=>x.Kind).OrderBy(x=>SpecialOrder(x.Key))) { <h3>@(group.Key=="Trade"?"In-game trades":group.Key+" Pokémon")</h3><div class="drawer-grid">@foreach(var mon in group.OrderBy(x=>x.Species)){<button class="mini-find @(CurrentProgress.CompletedSpecial.Contains(mon.Id)?"done":"")" @onclick="()=>ToggleSpecial(mon)"><i>★</i><img alt="" src="@PokemonIcon(mon.SpeciesId)" onerror="this.src='sprites/pokemon/question_mark.png'"/><span><strong>@mon.Species</strong><small>@(mon.Kind=="Trade"?$"For {mon.RequestedSpecies}":$"Lv. {mon.Level}")</small></span></button>}</div> }
                    }
                    @if (detailArea.Items.Any())
                    {
                        @foreach(var group in ItemGroupsFor(detailArea)){<h3>@group.Key items <small>@group.Count()</small></h3><div class="drawer-items">@foreach(var item in group.OrderBy(x=>x.Name)){<label class="@(CurrentProgress.Collected.Contains(item.Id)?"done":"")"><input type="checkbox" checked="@CurrentProgress.Collected.Contains(item.Id)" @onchange="()=>ToggleItem(item.Id)"/><img alt="" src="@ItemIcon(item)" onerror="this.src='sprites/items/question_mark.png'"/><span><strong>@item.Name</strong><small>@(item.X<0?"Received from an event":$"X {item.X}, Y {item.Y}")</small></span></label>}</div>}
                    }
                }
            </aside>
        </section>
    </main>
}

@if(interiorOpen && interiorArea is not null)
{
    <div class="interior-backdrop">
        <section class="interior-modal" role="dialog" aria-modal="true" aria-labelledby="interior-title">
            <header><div><span class="eyebrow">INTERIOR MAP</span><h2 id="interior-title">@InteriorTitle</h2></div>@if(InteriorFloors.Count>1){<select aria-label="Interior floor" @onchange="ChangeInterior">@foreach(var floor in InteriorFloors){<option value="@floor.Id" selected="@(floor==interiorArea)">@floor.Name</option>}</select>}<button aria-label="Close interior map" @onclick="()=>interiorOpen=false">×</button></header>
            <div class="interior-body">
                <div class="interior-map"><div class="interior-map-controls"><button aria-label="Zoom interior out" @onclick="()=>ZoomInterior(.8)">−</button><button aria-label="Fit interior map" @onclick="FitInterior">⌖</button><button aria-label="Zoom interior in" @onclick="()=>ZoomInterior(1.25)">+</button></div><div class="interior-canvas" style="width:@(interiorArea.MapWidth)px;height:@(interiorArea.MapHeight)px"><img alt="@InteriorTitle map" src="@interiorArea.MapImage" draggable="false"/>@foreach(var item in interiorArea.Items.Where(x=>x.X>=0)){<button aria-label="@item.Name" class="map-marker @(item.Kind=="Hidden"?"hidden-marker":"item-marker")" style="left:@(item.X*16+8)px;top:@(item.Y*16+8)px" @onclick="()=>InspectInteriorItem(item)"><span>@(item.Kind=="Hidden"?"?":"◆")</span><label>@item.Name@(item.Quantity>1?$" ×{item.Quantity}":"")</label></button>}@foreach(var warp in interiorArea.Entrances.Where(x=>InteriorFloors.Any(f=>f.Id==x.TargetId))){<button aria-label="Go to @warp.Name" class="map-marker entrance-marker" style="left:@(warp.X*16+8)px;top:@(warp.Y*16+8)px" @onclick="()=>NavigateInterior(warp)"><span>⌂</span><label>@warp.Name</label></button>}</div></div>
                <div class="interior-guide">
                    @if(inspectedItem is not null){<div class="focused-find"><img alt="" src="@ItemIcon(inspectedItem)" onerror="this.src='sprites/items/question_mark.png'"/><div><strong>@inspectedItem.Name</strong><small>@inspectedItem.Kind item</small></div><label><input type="checkbox" checked="@CurrentProgress.Collected.Contains(inspectedItem.Id)" @onchange="()=>ToggleItem(inspectedItem.Id)"/> Collected</label></div>}
                    @foreach(var encounterGroup in EncounterGroupsFor(interiorArea)){<h3>@encounterGroup.Key</h3><div class="drawer-grid">@foreach(var mon in encounterGroup.GroupBy(x=>x.SpeciesId).OrderBy(x=>x.First().Species)){var first=mon.First();<button class="mini-find @(CurrentProgress.Caught.Contains(mon.Key)?"done":"")" @onclick="()=>ToggleCaught(mon.Key)"><i>✓</i><img alt="" src="@PokemonIcon(first.SpeciesId)" onerror="this.src='sprites/pokemon/question_mark.png'"/><span><strong>@first.Species</strong><small>@LevelText(mon)</small></span></button>}</div>}
                    @foreach(var group in interiorArea.SpecialPokemon.Where(x=>x.Version=="Both"||x.Version==progress.Version).GroupBy(x=>x.Kind).OrderBy(x=>SpecialOrder(x.Key))){<h3>@(group.Key=="Trade"?"In-game trades":group.Key+" Pokémon")</h3><div class="drawer-grid">@foreach(var mon in group.OrderBy(x=>x.Species)){<button class="mini-find @(CurrentProgress.CompletedSpecial.Contains(mon.Id)?"done":"")" @onclick="()=>ToggleSpecial(mon)"><i>★</i><img alt="" src="@PokemonIcon(mon.SpeciesId)" onerror="this.src='sprites/pokemon/question_mark.png'"/><span><strong>@mon.Species</strong><small>@(mon.Kind=="Trade"?$"For {mon.RequestedSpecies}":$"Lv. {mon.Level}")</small></span></button>}</div>}
                    @foreach(var group in ItemGroupsFor(interiorArea)){<h3>@group.Key items</h3>@foreach(var item in group.OrderBy(x=>x.Name)){<label class="interior-check @(CurrentProgress.Collected.Contains(item.Id)?"done":"")"><input type="checkbox" checked="@CurrentProgress.Collected.Contains(item.Id)" @onchange="()=>ToggleItem(item.Id)"/><img alt="" src="@ItemIcon(item)" onerror="this.src='sprites/items/question_mark.png'"/><span>@item.Name</span></label>}}
                </div>
            </div>
        </section>
    </div>
}

@if(pokedexOpen)
{
    <div class="pokedex-backdrop" @onclick="()=>pokedexOpen=false"><section class="pokedex-modal" role="dialog" aria-modal="true" aria-labelledby="pokedex-title" @onclick:stopPropagation><header><div><span class="eyebrow">@(progress.DexMode.ToUpperInvariant()) POKÉDEX</span><h2 id="pokedex-title">@DexCaughtCount / @VisiblePokedex.Count() caught</h2></div><div class="dex-mode" aria-label="Pokédex type"><button class="@(progress.DexMode=="Normal"?"active":"")" @onclick='()=>ChangeDexMode("Normal")'>Normal</button><button class="@(progress.DexMode=="National"?"active":"")" @onclick='()=>ChangeDexMode("National")'>National</button></div><input aria-label="Search Pokédex" placeholder="Search name or number…" @bind="pokedexQuery" @bind:event="oninput"/><button class="dex-close" aria-label="Close Pokédex" @onclick="()=>pokedexOpen=false">×</button></header><div class="pokedex-grid">@foreach(var mon in FilteredPokedex){var caught=CurrentProgress.Caught.Contains(mon.SpeciesId);var availability=PokedexAvailability(mon);<button class="dex-entry @(caught?"caught":"") @(availability=="Obtainable"?"":"unavailable")" @onclick="()=>ToggleCaught(mon.SpeciesId)"><span class="dex-number">#@DexNumber(mon).ToString("D3")</span><img alt="" src="@PokemonIcon(mon.SpeciesId)" onerror="this.src='sprites/pokemon/question_mark.png'"/><span><strong>@mon.Name</strong><small>@(caught?"Caught":availability)</small></span><i>✓</i></button>}</div></section></div>
}

@if(confirmReset){<div class="modal-backdrop" @onclick="()=>confirmReset=false"><div class="modal" role="dialog" aria-modal="true" aria-labelledby="reset-title" @onclick:stopPropagation><span class="warning">!</span><h2 id="reset-title">Reset all progress?</h2><p>This clears every caught Pokémon and collected item on this device.</p><div><button @onclick="()=>confirmReset=false">Cancel</button><button class="danger" @onclick="Reset">Reset everything</button></div></div></div>}

@code {
    FieldGuideData? data; List<PokedexEntry> pokedex=[]; List<GuideWorld> worlds=[]; GuideWorld? currentWorld; GuideArea? mapArea; GuideArea? detailArea; GuideArea? interiorArea; GuideItem? inspectedItem; SavedProgress progress=new(); string query="",pokedexQuery="",region="Kanto"; bool confirmReset,searchOpen,interiorOpen,pokedexOpen; ElementReference mapViewport; string? initializedMap,initializedInterior;
    VersionProgress CurrentProgress { get { if(!progress.Games.TryGetValue(progress.Version,out var game)){game=new();progress.Games[progress.Version]=game;}return game;} }
    string PokedexAvailability(PokedexEntry mon)=>mon.Availability.TryGetValue(progress.Version,out var status)?status:"Trade / transfer required";
    IEnumerable<PokedexEntry> VisiblePokedex=>progress.DexMode=="National"?pokedex:pokedex.Where(p=>p.RegionalNumber.HasValue);
    IEnumerable<PokedexEntry> FilteredPokedex=>VisiblePokedex.Where(p=>string.IsNullOrWhiteSpace(pokedexQuery)||p.Name.Contains(pokedexQuery,StringComparison.OrdinalIgnoreCase)||DexNumber(p).ToString().Contains(pokedexQuery.Trim()));
    int DexNumber(PokedexEntry mon)=>progress.DexMode=="Normal"?mon.RegionalNumber??mon.Number:mon.Number;
    int DexCaughtCount=>VisiblePokedex.Count(p=>CurrentProgress.Caught.Contains(p.SpeciesId));
    IEnumerable<GuideArea> OutdoorAreas => (string.IsNullOrWhiteSpace(query)?currentWorld!.Maps.Select(m=>AreaFor(m.Id)).OfType<GuideArea>():data!.Areas.Where(a=>a.MapImage is not null&&a.Name.Contains(query,StringComparison.OrdinalIgnoreCase))).OrderBy(a=>NaturalKey(a.Name)).Take(80);
    IEnumerable<Encounter> VisibleEncounters => (detailArea?.Encounters??[]).Where(e=>e.Version=="Both"||e.Version==progress.Version);
    IEnumerable<SpecialPokemon> VisibleSpecial => (detailArea?.SpecialPokemon??[]).Where(e=>e.Version=="Both"||e.Version==progress.Version);
    IEnumerable<IGrouping<string,Encounter>> EncounterGroups => GroupEncounters(VisibleEncounters);
    List<GuideArea> InteriorFloors => interiorArea is null?[]:InteriorComponent(interiorArea.Id).OrderBy(a=>NaturalKey(a.Name)).ToList();
    string InteriorTitle=>interiorArea!.Name;
    protected override async Task OnInitializedAsync(){data=await Http.GetFromJsonAsync<FieldGuideData>("data/fieldguide.json");pokedex=await Http.GetFromJsonAsync<List<PokedexEntry>>("data/pokedex.json")??[];worlds=await Http.GetFromJsonAsync<List<GuideWorld>>("maps/worlds.json")??[];currentWorld=worlds.First(x=>x.Id=="kanto");progress=await JS.InvokeAsync<SavedProgress?>("fieldGuide.load")??new();if(MigrateProgress())await Save();mapArea=data!.Areas.First(a=>a.Id=="MAP_ROUTE1");detailArea=mapArea;}
    protected override async Task OnAfterRenderAsync(bool first){await JS.InvokeVoidAsync("fieldGuide.applyAppearance",progress.Theme,progress.Version);if(currentWorld?.Id!=initializedMap){initializedMap=currentWorld?.Id;await JS.InvokeVoidAsync("fieldMap.init",mapViewport);}if(interiorOpen&&interiorArea?.Id!=initializedInterior){initializedInterior=interiorArea?.Id;await JS.InvokeVoidAsync("fieldMap.initInterior");}if(!interiorOpen)initializedInterior=null;}
    GuideArea? AreaFor(string id)=>data!.Areas.FirstOrDefault(a=>a.Id==(id=="MAP_SAFFRON_CITY_CONNECTION"?"MAP_SAFFRON_CITY":id));
    IEnumerable<IGrouping<string,Encounter>> EncounterGroupsFor(GuideArea area)=>GroupEncounters(area.Encounters.Where(e=>e.Version=="Both"||e.Version==progress.Version));
    IEnumerable<IGrouping<string,Encounter>> GroupEncounters(IEnumerable<Encounter> rows)=>rows.GroupBy(EncounterGroupName).OrderBy(g=>EncounterOrder(g.Key));
    static string EncounterGroupName(Encounter e)=>e.Method.StartsWith("Roaming",StringComparison.Ordinal)?"Roaming encounters":e.Method switch { "Grass / cave"=>"Random encounters", "Surf"=>"Surfing", "Old Rod"=>"Fishing · Old Rod", "Good Rod"=>"Fishing · Good Rod", "Super Rod"=>"Fishing · Super Rod", _=>e.Method };
    IEnumerable<IGrouping<string,GuideItem>> ItemGroupsFor(GuideArea area)=>area.Items.GroupBy(x=>x.Kind).OrderBy(x=>ItemOrder(x.Key));
    IEnumerable<DisplayEntrance> RelevantEntrancesFor(GuideArea area)
    {
        var resolved=area.Entrances.Select(e=>(Warp:e,Target:ResolveRelevantTarget(area.Id,e.TargetId))).Where(x=>x.Target is not null).Select(x=>new DisplayEntrance(x.Target!.Id,x.Target.Name,x.Warp.X,x.Warp.Y)).ToList();
        foreach(var targetGroup in resolved.GroupBy(x=>x.TargetId))
        {
            var remaining=targetGroup.ToList();
            while(remaining.Count>0)
            {
                var cluster=new List<DisplayEntrance>{remaining[0]};remaining.RemoveAt(0);
                for(var i=0;i<cluster.Count;i++) for(var j=remaining.Count-1;j>=0;j--) if(Math.Abs(cluster[i].X-remaining[j].X)<=1&&Math.Abs(cluster[i].Y-remaining[j].Y)<=1){cluster.Add(remaining[j]);remaining.RemoveAt(j);}
                yield return new DisplayEntrance(targetGroup.Key,cluster[0].Name,cluster.Average(x=>x.X),cluster.Average(x=>x.Y));
            }
        }
    }
    GuideArea? ResolveRelevantTarget(string sourceId,string targetId)
    {
        var queue=new Queue<string>();var visited=new HashSet<string>{sourceId};if(!string.IsNullOrEmpty(targetId))queue.Enqueue(targetId);
        while(queue.Count>0){var id=queue.Dequeue();if(!visited.Add(id))continue;var area=AreaFor(id);if(area is null)continue;if(IsOutdoor(id))continue;if(area.Items.Count+area.SpecialPokemon.Count+area.Encounters.Count>0)return area;foreach(var exit in area.Entrances)if(!visited.Contains(exit.TargetId))queue.Enqueue(exit.TargetId);}
        return null;
    }
    bool IsOutdoor(string id)=>id=="MAP_SAFFRON_CITY"||worlds.Any(world=>world.Maps.Any(map=>map.Id==id));
    IEnumerable<GuideArea> InteriorComponent(string startId)
    {
        var queue=new Queue<string>();var visited=new HashSet<string>();queue.Enqueue(startId);
        while(queue.Count>0){var id=queue.Dequeue();if(!visited.Add(id)||IsOutdoor(id))continue;var area=AreaFor(id);if(area is null)continue;yield return area;foreach(var exit in area.Entrances)if(!string.IsNullOrEmpty(exit.TargetId)&&!visited.Contains(exit.TargetId))queue.Enqueue(exit.TargetId);}
    }
    void SelectArea(GuideArea area){mapArea=area;detailArea=area;inspectedItem=null;searchOpen=false;query="";}
    void SelectSearchArea(GuideArea area){if(IsOutdoor(area.Id)){var world=worlds.FirstOrDefault(w=>w.Maps.Any(m=>m.Id==area.Id||(area.Id=="MAP_SAFFRON_CITY"&&m.Id=="MAP_SAFFRON_CITY_CONNECTION")));if(world is not null&&world!=currentWorld){currentWorld=world;initializedMap=null;}SelectArea(area);}else{OpenEntrance(area.Id);searchOpen=false;query="";}}
    void ShowKanto(){region="Kanto";currentWorld=worlds.First(x=>x.Id=="kanto");initializedMap=null;} void ShowSevii(){region="Sevii Islands";currentWorld=worlds.First(x=>x.Id=="sevii");initializedMap=null;}
    void OpenEntrance(string targetId){interiorArea=data!.Areas.FirstOrDefault(a=>a.Id==targetId);if(interiorArea is not null){interiorOpen=true;inspectedItem=null;}}
    void InspectItem(GuideArea area,GuideItem item){mapArea=area;detailArea=area;inspectedItem=item;}
    void InspectInteriorItem(GuideItem item)=>inspectedItem=item; void NavigateInterior(MapEntrance warp){interiorArea=data!.Areas.FirstOrDefault(a=>a.Id==warp.TargetId)??interiorArea;inspectedItem=null;} void ChangeInterior(ChangeEventArgs e){interiorArea=data!.Areas.FirstOrDefault(a=>a.Id==(string?)e.Value)??interiorArea;inspectedItem=null;}
    async Task Zoom(double z)=>await JS.InvokeVoidAsync("fieldMap.zoom",mapViewport,z); async Task ResetView()=>await JS.InvokeVoidAsync("fieldMap.reset",mapViewport);
    async Task ZoomInterior(double z)=>await JS.InvokeVoidAsync("fieldMap.zoomInterior",z); async Task FitInterior()=>await JS.InvokeVoidAsync("fieldMap.fitInterior");
    bool MigrateProgress(){progress.Games??=[];if(progress.Games.Count>0)return false;var legacy=progress.Caught.Count+progress.Collected.Count+progress.CompletedSpecial.Count>0;progress.Games[progress.Version]=new(){Caught=[..progress.Caught],Collected=[..progress.Collected],CompletedSpecial=[..progress.CompletedSpecial]};progress.Games[progress.Version=="FireRed"?"LeafGreen":"FireRed"]=new();progress.Caught.Clear();progress.Collected.Clear();progress.CompletedSpecial.Clear();return legacy;}
    async Task Save()=>await JS.InvokeVoidAsync("fieldGuide.save",progress); async Task ToggleItem(string id){if(!CurrentProgress.Collected.Add(id))CurrentProgress.Collected.Remove(id);await Save();} async Task ToggleCaught(string id){if(!CurrentProgress.Caught.Add(id))CurrentProgress.Caught.Remove(id);await Save();} async Task ToggleSpecial(SpecialPokemon m){if(!CurrentProgress.CompletedSpecial.Add(m.Id))CurrentProgress.CompletedSpecial.Remove(m.Id);CurrentProgress.Caught.Add(m.SpeciesId);await Save();}
    async Task ChangeVersion(ChangeEventArgs e){progress.Version=(string?)e.Value??"FireRed";await Save();await JS.InvokeVoidAsync("fieldGuide.applyAppearance",progress.Theme,progress.Version);}
    async Task ChangeDexMode(string mode){progress.DexMode=mode;pokedexQuery="";await Save();}
    async Task ToggleTheme(){progress.Theme=progress.Theme=="Dark"?"Light":"Dark";await Save();await JS.InvokeVoidAsync("fieldGuide.applyAppearance",progress.Theme,progress.Version);}
    int AreaPercent(GuideArea a){var species=a.Encounters.Where(e=>e.Version=="Both"||e.Version==progress.Version).Select(e=>e.SpeciesId).Distinct().ToList();var special=a.SpecialPokemon.Where(m=>m.Version=="Both"||m.Version==progress.Version).ToList();var total=species.Count+a.Items.Count+special.Count;return total==0?0:(int)Math.Round(100d*(species.Count(CurrentProgress.Caught.Contains)+a.Items.Count(i=>CurrentProgress.Collected.Contains(i.Id))+special.Count(m=>CurrentProgress.CompletedSpecial.Contains(m.Id)))/total);}
    static string LevelText(IEnumerable<Encounter> e){var min=e.Min(x=>x.MinLevel);var max=e.Max(x=>x.MaxLevel);return min==max?$"Lv. {min}":$"Lv. {min}–{max}";} async Task Reset(){var v=progress.Version;var t=progress.Theme;var d=progress.DexMode;progress=new(){Version=v,Theme=t,DexMode=d};confirmReset=false;await Save();}
    static string InteriorKey(string id)
    {
        if(System.Text.RegularExpressions.Regex.IsMatch(id,@"^MAP_SAFARI_ZONE_(?:CENTER|EAST|NORTH|WEST)$"))return "MAP_SAFARI_ZONE";
        return System.Text.RegularExpressions.Regex.Replace(id,@"_(?:B?\d+F|ROOF|BASEMENT|ENTRANCE|BACK|ROOM\d+)$","",System.Text.RegularExpressions.RegexOptions.IgnoreCase);
    }
    static int EncounterOrder(string name)=>name switch{"Random encounters"=>0,"Surfing"=>1,"Fishing · Old Rod"=>2,"Fishing · Good Rod"=>3,"Fishing · Super Rod"=>4,"Roaming encounters"=>5,"Rock Smash"=>6,_=>7};
    static int SpecialOrder(string kind)=>kind switch{"Static"=>0,"Gift"=>1,"Trade"=>2,_=>3};
    static int ItemOrder(string kind)=>kind switch{"Visible"=>0,"Hidden"=>1,"Event"=>2,_=>3};
    static string NaturalKey(string name)=>System.Text.RegularExpressions.Regex.Replace(name.ToUpperInvariant(),@"\d+",m=>int.Parse(m.Value).ToString("D8"));
    const string UnownIcon="data:image/png;base64,";
    static string PokemonIcon(string id)=>id=="SPECIES_UNOWN"?UnownIcon:$"sprites/pokemon/{id.Replace("SPECIES_","").ToLowerInvariant()}.png";
    static string ItemIcon(GuideItem item)=>$"sprites/items/{item.Icon}";
    static string ItemIcon(string name){var slug=System.Text.RegularExpressions.Regex.Replace(name.ToLowerInvariant(),@"[^a-z0-9]+","_").Trim('_');slug=slug switch{"full_restore" or "max_potion"=>"large_potion","max_elixir" or "elixir" or "max_ether"=>"ether","awakening" or "burn_heal" or "ice_heal" or "paralyze_heal"=>"status_heal","calcium" or "carbos" or "iron" or "protein" or "zinc"=>"vitamin","ruby" or "sapphire"=>"gem",_ when slug.StartsWith("tm")||slug.StartsWith("hm")=>"tm_hm",_=>slug};return $"sprites/items/{slug}.png";}
